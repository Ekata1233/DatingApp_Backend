model Event {
  id String @id @default(uuid()) @db.Uuid

  // Business
  businessDetailsId String?          @db.Uuid
  businessDetails   BusinessDetails? @relation(fields: [businessDetailsId], references: [id])

  // Step 1 - Basics
  eventDurationType EventDurationType?
  tripType          TripType?
  categoryId        String?            @db.Uuid
  category          EventCategory?     @relation(fields: [categoryId], references: [id])
  title             String?
  tagline           String?
  about             String?
  visibility        EventVisibility?

  // Step 2 - Photos
  highlightsCaption String?

  // Experience
  experienceSubtitle String?

  // Tickets & Crowd

  priceType EventPriceType @default(PER_PERSON)

  // Total guest capacity
  totalCapacity Int?

  // Singles pricing
  menCapacity   Int?
  womenCapacity Int?
  otherCapacity Int?

  menEntryPrice   Decimal? @db.Decimal(10, 2)
  womenEntryPrice Decimal? @db.Decimal(10, 2)
  otherEntryPrice Decimal? @db.Decimal(10, 2)

  menDiscountPercentage   Decimal? @db.Decimal(5, 2)
  womenDiscountPercentage Decimal? @db.Decimal(5, 2)
  otherDiscountPercentage Decimal? @db.Decimal(5, 2)

  menDiscountedPrice   Decimal? @db.Decimal(10, 2)
  womenDiscountedPrice Decimal? @db.Decimal(10, 2)
  otherDiscountedPrice Decimal? @db.Decimal(10, 2)

  // Couples pricing
  coupleCapacity           Int?
  coupleEntryPrice         Decimal? @db.Decimal(10, 2)
  coupleDiscountPercentage Decimal? @db.Decimal(5, 2)
  coupleDiscountedPrice    Decimal? @db.Decimal(10, 2)

  // Booking restrictions
  maxTicketsPerPerson Int     @default(1)
  waitlistEnabled     Boolean @default(true)

  // Crowd details
  crowdMix  CrowdMix?
  minAge    Int?
  maxAge    Int?
  groupSize Int?
  intent    EventIntent?

  // Included & Packing
  included             String[]       @default([])
  notIncluded          String[]       @default([])
  whatToBring          String[]       @default([])
  dressCode            EventDressCode @default(NONE)
  // Group Chat
  groupChatTitle       String?
  groupChatDescription String?
  groupChatOpensAt     DateTime?

  // Reminders
  reminderTitle       String?
  reminderDescription String?
  reminderTimes       DateTime[] @default([])
  // Host / Trip Captain
  hostId              String?    @db.Uuid
  host                Host?      @relation("EventPrimaryHost", fields: [hostId], references: [id])
  hostPhotoUrl        String?
  hostTitle           String?
  hostSpeciality      String?
  hostLanguages       String[]   @default([])
  hostMessage         String?
  afterEventLine      String?

  // Cancellation
  cancellationPolicy      EventCancellationPolicy?
  cancellationDescription String?

  // Refund
  refundPolicy String?

  // Rescheduling
  reschedulingPolicy String?

  // Event Rules
  rules String[] @default([])

  // Safety
  safetyOptions EventSafetyOption[] @default([])

  // Draft & Submission
  status          EventStatus @default(DRAFT)
  currentStep     Int         @default(1)
  completedSteps  Int[]       @default([])
  submittedAt     DateTime?
  approvedAt      DateTime?
  publishedAt     DateTime?
  rejectionReason String?
  isDeleted       Boolean     @default(false)

  // Relations
  photos      EventPhoto[]
  dates       EventDate[]
  venue       EventVenue?
  experience  EventExperience[]
  tripDetails TripDetails?
  faqs        EventFAQ[]
  hosts       EventHost[]
  bookings    EventBooking[]

  // Ratings Summary
  averageRating Decimal @default(0) @db.Decimal(3, 2)
  totalReviews  Int     @default(0)

  // Relation
  reviews EventReview[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  ChatMessage ChatMessage[]

  @@index([hostId])
  @@index([businessDetailsId])
  @@index([categoryId])
  @@index([status])
  @@index([visibility, status])
  @@index([eventDurationType, status])
  @@index([businessDetailsId, status, updatedAt])
  @@index([businessDetailsId, deletedAt, status])
  @@map("events")
}

model EventPhoto {
  id        String         @id @default(uuid()) @db.Uuid
  eventId   String         @db.Uuid
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photoUrl  String
  fileId    String?
  photoType EventPhotoType
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, photoType, sortOrder])
  @@map("event_photos")
}

model EventDate {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @db.Uuid
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startDateTime DateTime
  endDateTime   DateTime?
  gateOpensAt   DateTime?
  timezone      String    @default("Asia/Kolkata")

  status             EventDateStatus @default(SCHEDULED)
  isPrimary          Boolean         @default(false)
  isMoreDate         Boolean         @default(false)
  cancelledAt        DateTime?
  cancellationReason String?

  reviews EventReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, startDateTime])
  @@index([eventId, status])
  @@index([status, startDateTime])
  @@map("event_dates")
}

model EventVenue {
  id                String     @id @default(uuid()) @db.Uuid
  eventId           String     @unique @db.Uuid
  event             Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Venue
  venueName         String?
  fullAddress       String?
  venueType         VenueType?
  venueCapacity     Int?
  // Venue Card
  whySpecial        String?
  tags              String[]   @default([])
  photoUrl          String?
  // Meeting Details
  exactMeetingPoint String?
  distanceFromCity  String?
  landmark          String?
  parking           String?
  publicTransport   String?
  googleMapsLink    String?
  latitude          Float?
  longitude         Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_venues")
}

model EventExperience {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  icon        String?
  time        String?
  title       String?
  description String?
  photoUrl    String?
  tags        String[] @default([])
  location    String?
  sortOrder   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, sortOrder])
  @@map("event_experiences")
}

model TripDetails {
  id               String       @id @default(uuid()) @db.Uuid
  eventId          String       @unique @db.Uuid
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Dates & Route
  totalDays        Int          @default(2)
  travelBy         TravelType?
  // Pickup
  pickupCity       String?
  pickupPoint      String?
  exactPickupSpot  String?
  pickupMapsLink   String?
  pickupLatitude   Float?
  pickupLongitude  Float?
  // Destination
  destinationPlace String?
  destinationArea  String?
  journeyThere     String?
  journeyBack      String?
  destinationIcon  String?
  // Drop
  dropCity         String?
  dropPoint        String?
  // Rooms
  roomSharing      RoomSharing?
  stayTile         String?
  mealsTile        String?
  // Ride Ops - Host Only

  vehiclePhotos   String[]         @default([])
  vehicle         String
  vehicleOperator String?
  vehicleModel    String?
  vehicleCapacity Int?
  vehicleSpecs    String[]         @default([])
  onBoard         String[]         @default([])
  safetyNoteTitle String?
  safetyNote      String?
  // Relations
  days            TripDay[]
  stays           TripStay[]
  places          TripPlace[]
  roomOptions     TripRoomOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trip_details")
}

model TripDay {
  id              String         @id @default(uuid()) @db.Uuid
  tripDetailsId   String         @db.Uuid
  tripDetails     TripDetails    @relation(fields: [tripDetailsId], references: [id], onDelete: Cascade)
  dayNumber       Int
  headline        String?
  photoUrl        String?
  highlightPhotos String[]       @default([])
  mealsIncluded   MealType[]     @default([])
  level           TripLevel?
  // Night Stay
  nightType       TripNightType?
  stayId          String?        @db.Uuid
  stay            TripStay?      @relation(fields: [stayId], references: [id], onDelete: Restrict)
  // Relations
  stops           TripStop[]
  games           TripGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripDetailsId, dayNumber])
  @@index([stayId])
  @@map("trip_days")
}

model TripStop {
  id          String      @id @default(uuid()) @db.Uuid
  tripDayId   String      @db.Uuid
  tripDay     TripDay     @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  title       String?
  description String?
  timeLabel   String?
  icon        String?
  tag         TripStopTag @default(NONE)
  photoUrl    String?
  sortOrder   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripDayId, sortOrder])
  @@map("trip_stops")
}

model TripStay {
  id            String      @id @default(uuid()) @db.Uuid
  tripDetailsId String      @db.Uuid
  tripDetails   TripDetails @relation(fields: [tripDetailsId], references: [id], onDelete: Cascade)
  stayName      String?
  area          String?
  tagline       String?
  photos        String[]    @default([])
  amenities     String[]    @default([])
  checkIn       String?
  checkOut      String?
  // Host Only
  address       String?
  contact       String?
  // Relations
  days          TripDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tripDetailsId])
  @@map("trip_stays")
}

model TripPlace {
  id            String      @id @default(uuid()) @db.Uuid
  tripDetailsId String      @db.Uuid
  tripDetails   TripDetails @relation(fields: [tripDetailsId], references: [id], onDelete: Cascade)
  icon          String?
  name          String?
  when          String?
  whySpecial    String?
  tags          String[]    @default([])
  photoUrl      String?
  sortOrder     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripDetailsId, sortOrder])
  @@map("trip_places")
}

model TripGame {
  id         String  @id @default(uuid()) @db.Uuid
  tripDayId  String  @db.Uuid
  tripDay    TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  icon       String?
  name       String?
  howItPlays String?
  whyItWorks String?
  sortOrder  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripDayId, sortOrder])
  @@map("trip_games")
}

model TripRoomOption {
  id            String      @id @default(uuid()) @db.Uuid
  tripDetailsId String      @db.Uuid
  tripDetails   TripDetails @relation(fields: [tripDetailsId], references: [id], onDelete: Cascade)
  name          String?
  shortNote     String?
  upgradePrice  Decimal     @default(0) @db.Decimal(12, 2)
  isIncluded    Boolean     @default(false)
  sortOrder     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tripDetailsId, sortOrder])
  @@map("trip_room_options")
}

model EventFAQ {
  id        String  @id @default(uuid()) @db.Uuid
  eventId   String  @db.Uuid
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question  String?
  answer    String?
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, sortOrder])
  @@map("event_faqs")
}

model EventReview {
  id             String            @id @default(uuid()) @db.Uuid
  eventId        String            @db.Uuid
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventDateId    String            @db.Uuid
  eventDate      EventDate         @relation(fields: [eventDateId], references: [id])
  userId         String            @db.Uuid
  user           User              @relation(fields: [userId], references: [id])
  rating         Int
  title          String?
  review         String?           @db.Text
  photos         String[]          @default([])
  status         EventReviewStatus @default(PUBLISHED)
  isVerified     Boolean           @default(false)
  organizerReply String?           @db.Text
  repliedAt      DateTime?
  repliedById    String?           @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventDateId, userId])
  @@index([eventId, status])
  @@index([eventId, rating])
  @@index([userId])
  @@map("event_reviews")
}

model EventBooking {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  eventId             String               @db.Uuid
  bookingNumber       String               @unique @db.VarChar(50)
  ticketCount         Int                  @default(1)
  ticketAmount        Decimal              @db.Decimal(10, 2)
  platformFee         Decimal              @default(0) @db.Decimal(10, 2)
  gstAmount           Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0) @db.Decimal(10, 2)
  couponCode          String?              @db.VarChar(50)
  totalAmount         Decimal              @db.Decimal(10, 2)
  paidAmount          Decimal              @default(0) @db.Decimal(10, 2)
  status              EventBookingStatus   @default(PENDING)
  paymentId           String?              @unique @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  cancellationComment String?              @db.VarChar(500)
  cancellationReason  String?              @db.VarChar(100)
  cancelledAt         DateTime?
  refundAmount        Decimal?             @db.Decimal(10, 2)
  refundEligible      Boolean?
  refundReason        String?
  refundReferenceId   String?              @db.VarChar(255)
  refundRequestedAt   DateTime?
  refundedAt          DateTime?
  event               Event                @relation(fields: [eventId], references: [id])
  payment             Payment?             @relation(fields: [paymentId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  tickets             EventBookingTicket[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([bookingNumber])
}

model EventBookingTicket {
  id           String            @id @default(uuid()) @db.Uuid
  bookingId    String            @db.Uuid
  ticketId     String            @unique @db.VarChar(50)
  ticketType   EventTicketType
  ticketAmount Decimal           @db.Decimal(10, 2)
  qrCodeUrl    String?
  status       EventTicketStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  booking      EventBooking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([ticketType])
  @@index([status])
}

enum EventReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
}

enum TripType {
  GROUP_TRIP
  COUPLES_TRIP
}

enum EventVisibility {
  FREE_AND_PREMIUM
  VIP_AND_VIP_ELITE
}

enum EventPhotoType {
  EVENT
  HIGHLIGHT
}

enum EventStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  CANCELLED
  COMPLETED
}

enum EventDateStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum VenueType {
  CAFE_BAR
  RESTAURANT
  STUDIO
  ROOFTOP
  OUTDOOR_TRAIL
  CAMPSITE
  RESORT_VILLA
  PUBLIC_PLACE
}

enum EventPriceType {
  PER_PERSON
  PER_COUPLE
}

enum CrowdMix {
  BALANCED
  OPEN
}

enum EventIntent {
  SERIOUS_DATING
  CASUAL_SOCIAL
  OPEN_TO_BOTH
}

enum EventDressCode {
  NONE
  CASUAL
  SMART_CASUAL
  ACTIVEWEAR
  TREK_GEAR
  ETHNIC
  ALL_WHITE
}

enum TravelType {
  AC_SLEEPER_BUS
  AC_SEATER_BUS
  TEMPO_TRAVELLER
  TRAIN_3AC
  SELF_DRIVE_CONVOY
  FLIGHT
  PRIVATE_CAB
}

enum MealType {
  BREAKFAST
  BRUNCH
  LUNCH
  SNACKS
  DINNER
}

enum TripLevel {
  EASY
  MODERATE
  CHALLENGING
}

enum TripNightType {
  STAY
  OVERNIGHT_TRAVEL
  RETURN_HOME
}

enum TripStopTag {
  NONE
  INCLUDED
  NOT_INCLUDED
  PICK_ONE
  PICKUP_POINT
  DROP_OFF_POINT
}

enum RoomSharing {
  TWIN_SHARING
  DORM
  TENT_SHARING
  TRIPLE_SHARING
  PRIVATE_ROOM
}

enum EventCancellationPolicy {
  STANDARD
  TRIPS_AND_CAMPING
  STRICT
}

enum EventSafetyOption {
  TRAINED_HOST
  VETTED_VENUE
  WOMAN_ON_HOST_TEAM
  SEPARATE_ROOMS_FOR_WOMEN
  SAFETY_BRIEF_AND_SOS
  RESPONSIBLE_ALCOHOL_SERVICE
  IDENTITY_CHECK
  CONTROLLED_ENTRY
  CCTV_MONITORED
}

enum EventBookingStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  ATTENDED
  EXPIRED
}

enum EventTicketType {
  MEN
  WOMEN
  OTHER
}

enum EventTicketStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED
}

enum EventAvailabilityStatus {
  DRAFT
  LIVE
  SOLD_OUT
  CANCELLED
}
