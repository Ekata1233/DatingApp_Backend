model UserCompliment {
  id          String           @id @default(uuid()) @db.Uuid
  senderId    String           @db.Uuid
  receiverId  String           @db.Uuid
  targetType  TargetType?
  targetId    String?          @db.Uuid
  ideaId      String?
  message     String?          @db.VarChar(140)
  status      ComplimentStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chatMessage ChatMessage?
  idea        ComplimentIdea?  @relation(fields: [ideaId], references: [id])
  receiver    User             @relation("ComplimentReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender      User             @relation("ComplimentSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId, status])
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

model UserComplimentBalance {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @db.Uuid
  totalCompliments     Int      @default(0)
  freeCompliments      Int      @default(0)
  purchasedCompliments Int      @default(0)
  weeklyLimit          Int      @default(0)
  totalComplimentsSent Int      @default(0)
  lastResetAt          DateTime
  nextResetAt          DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_compliment_balance")
}

model ComplimentPurchase {
  id                  String                  @id @default(uuid()) @db.Uuid
  userId              String                  @db.Uuid
  quantity            Int
  amount              Decimal                 @db.Decimal(10, 2)
  paymentMethod       PurchasePaymentMethod
  paymentId           String?
  walletTransactionId String?                 @db.Uuid
  createdAt           DateTime                @default(now())
  payment             Payment?                @relation(fields: [paymentId], references: [payment_id])
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransaction   WalletTransaction?      @relation(fields: [walletTransactionId], references: [id])
  transactions        ComplimentTransaction[]

  @@index([userId])
  @@index([paymentId])
}

model ComplimentTransaction {
  id                     String                    @id @default(uuid()) @db.Uuid
  userId                 String                    @db.Uuid
  type                   ComplimentTransactionType
  quantity               Int
  complimentBalanceAfter Int
  purchaseId             String?                   @db.Uuid
  createdAt              DateTime                  @default(now())
  purchase               ComplimentPurchase?       @relation(fields: [purchaseId], references: [id])
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([userId, createdAt])
}

model UserGift {
  id                  String             @id @default(uuid()) @db.Uuid
  senderId            String             @db.Uuid
  receiverId          String             @db.Uuid
  giftId              Int
  giftName            String
  pricePaid           Int
  message             String?            @db.VarChar(150)
  targetType          TargetType?
  targetId            String?            @db.Uuid
  walletTransactionId String?            @unique @db.Uuid
  requiredMessages    Int                @default(1)
  messagesSent        Int                @default(0)
  isUnlocked          Boolean            @default(false)
  unlockedAt          DateTime?
  expiresAt           DateTime
  createdAt           DateTime           @default(now())
  chatMessage         ChatMessage?
  gift                Gift               @relation(fields: [giftId], references: [id])
  receiver            User               @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender              User               @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])

  @@index([receiverId])
  @@index([senderId])
  @@index([giftId])
  @@index([receiverId, senderId, isUnlocked, expiresAt])
}

model Payment {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String               @db.Uuid
  amount             Decimal              @db.Decimal(10, 2)
  currency           String               @default("INR")
  payment_id         String?              @unique
  transactionId      String?
  status             PaymentStatus        @default(PENDING)
  purpose            PaymentPurpose
  referenceId        String?              @db.Uuid
  packagePriceId     String?              @db.Uuid
  gatewayResponse    Json?
  paidAt             DateTime?
  created_at         DateTime             @default(now())
  BoostPurchase      BoostPurchase[]
  ComplimentPurchase ComplimentPurchase[]
  eventbooking       EventBooking?
  RosePurchase       RosePurchase[]
  DatePlanPurchase   DatePlanPurchase[]
  inAppPurchase      InAppPurchase?
  UserPackage        UserPackage[]
  waitlist           Waitlist?
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  sender_id   String           @db.Uuid
  receiver_id String           @db.Uuid
  type        NotificationType
  title       String
  message     String
  data        Json?
  is_read     Boolean          @default(false)
  created_at  DateTime         @default(now())
  readAt      DateTime?
  receiver    User             @relation("ReceivedNotifications", fields: [receiver_id], references: [id], onDelete: Cascade)
  sender      User             @relation("SentNotifications", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([receiver_id])
  @@index([sender_id])
  @@index([receiver_id, is_read])
}

model UserNotificationSetting {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  isEnabled         Boolean   @default(true)
  mutedUntil        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  eventsEnabled     Boolean   @default(true)
  likesRosesEnabled Boolean   @default(true)
  messagesEnabled   Boolean   @default(true)
  newMatchesEnabled Boolean   @default(true)
  promotionsEnabled Boolean   @default(true)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserNotificationMute {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  mutedUserId String    @db.Uuid
  isMuted     Boolean   @default(true)
  mutedUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  mutedUser   User      @relation("NotificationMutedUser", fields: [mutedUserId], references: [id], onDelete: Cascade)
  user        User      @relation("NotificationMuteOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mutedUserId])
  @@index([mutedUserId])
}

model DatePlanPackage {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  planCount    Int
  price        Decimal  @db.Decimal(10, 2)
  pricePerPlan Decimal  @db.Decimal(10, 2)
  discount     Int?
  isPopular    Boolean  @default(false)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isBestValue  Boolean  @default(false)
}

model DatePlanPackageInfo {
  id                String   @id @default(uuid()) @db.Uuid
  howOnePlanWorks   Json?
  whyPeopleBuyPlans Json?
  goodToKnow        Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DatePlanPackageFeatures {
  id                     String   @id @default(uuid()) @db.Uuid
  costToPostPlan         Decimal  @default(100) @db.Decimal(10, 2)
  costToPostPlanActive   Boolean  @default(true)
  costToPostPlanPaidOnly Boolean  @default(false)
  planBoostPrice         Decimal  @default(40) @db.Decimal(10, 2)
  planBoostActive        Boolean  @default(true)
  planBoostPaidOnly      Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model DatePlanOption {
  id                     String            @id @default(uuid()) @db.Uuid
  type                   OptionType
  label                  String
  value                  String?
  icon                   String?
  sortOrder              Int               @default(0)
  isActive               Boolean           @default(true)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  activityPlans          DatePlan[]        @relation("PlanActivity")
  joinRequestGenderPlans DatePlan[]        @relation("PlanJoinRequestGender")
  quickTitlePlans        DatePlan[]        @relation("PlanQuickTitle")
  visibilityPlans        DatePlan[]        @relation("PlanVisibility")
  whoPaysPlans           DatePlan[]        @relation("PlanWhoPays")
  datePlanRequests       DatePlanRequest[] @relation("DatePlanRequestBillSuggestion")
  vibePlans              DatePlanVibe[]

  @@index([type, isActive])
}

model DatePlan {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @db.Uuid
  activityId          String              @db.Uuid
  title               String?
  quickTitleId        String?             @db.Uuid
  note                String?
  photoUrl            String?
  venueName           String?
  venueAddress        String?
  venueLat            Float?
  venueLng            Float?
  duration            Int?
  whoPaysId           String?             @db.Uuid
  participantLimit    Int?
  joinRequestGenderId String?             @db.Uuid
  visibilityId        String?             @db.Uuid
  status              PlanStatus          @default(DRAFT)
  eventDateTime       DateTime?
  expiresAt           DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  verifiedMembersOnly Boolean             @default(false)
  chatMessages        ChatMessage[]       @relation("DatePlanChatMessages")
  DateConfirmed       DateConfirmed[]
  activity            DatePlanOption      @relation("PlanActivity", fields: [activityId], references: [id])
  joinRequestGender   DatePlanOption?     @relation("PlanJoinRequestGender", fields: [joinRequestGenderId], references: [id])
  quickTitle          DatePlanOption?     @relation("PlanQuickTitle", fields: [quickTitleId], references: [id])
  user                User                @relation(fields: [userId], references: [id])
  visibility          DatePlanOption?     @relation("PlanVisibility", fields: [visibilityId], references: [id])
  whoPays             DatePlanOption?     @relation("PlanWhoPays", fields: [whoPaysId], references: [id])
  feedbacks           DatePlanFeedback[]
  reports             DatePlanReport[]
  requests            DatePlanRequest[]
  skips               DatePlanSkip[]
  userBoosts          DatePlanUserBoost[]
  vibes               DatePlanVibe[]

  @@index([userId])
  @@index([activityId])
  @@index([status])
  @@index([createdAt])
}

model DatePlanVibe {
  id     String         @id @default(uuid())
  planId String         @db.Uuid
  vibeId String         @db.Uuid
  plan   DatePlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  vibe   DatePlanOption @relation(fields: [vibeId], references: [id])

  @@unique([planId, vibeId])
  @@index([vibeId])
}

model DatePlanRequest {
  id               String                @id @default(uuid())
  planId           String                @db.Uuid
  requesterId      String                @db.Uuid
  status           DatePlanRequestStatus @default(PENDING)
  message          String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  billSuggestionId String?               @db.Uuid
  billSuggestion   DatePlanOption?       @relation("DatePlanRequestBillSuggestion", fields: [billSuggestionId], references: [id])
  plan             DatePlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  requester        User                  @relation(fields: [requesterId], references: [id])

  @@unique([planId, requesterId])
  @@index([planId])
  @@index([requesterId])
  @@index([status])
}

model DatePlanSkip {
  id        String   @id @default(uuid())
  userId    String   @db.Uuid
  planId    String   @db.Uuid
  createdAt DateTime @default(now())
  plan      DatePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
}

model DateConfirmed {
  id            String              @id @default(uuid()) @db.Uuid
  planId        String              @db.Uuid
  hostUserId    String              @db.Uuid
  participantId String              @db.Uuid
  title         String?
  venueName     String?
  venueAddress  String?
  eventDateTime DateTime
  status        ConfirmedDateStatus
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  host          User                @relation("ConfirmedDateHost", fields: [hostUserId], references: [id])
  participant   User                @relation("ConfirmedDateParticipant", fields: [participantId], references: [id])
  plan          DatePlan            @relation(fields: [planId], references: [id])
}

model DatePlanFeedback {
  id               String                   @id @default(uuid()) @db.Uuid
  planId           String                   @db.Uuid
  reviewerId       String                   @db.Uuid
  attendanceStatus DatePlanAttendanceStatus
  metUserId        String?                  @db.Uuid
  overallRating    Int?
  personRating     Int?
  noShowReason     DatePlanNoShowReason?
  comment          String?
  status           DatePlanFeedbackStatus   @default(SUBMITTED)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  metUser          User?                    @relation("DatePlanFeedbackMetUser", fields: [metUserId], references: [id])
  plan             DatePlan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewer         User                     @relation("DatePlanFeedbackReviewer", fields: [reviewerId], references: [id])
  experienceTags   DatePlanFeedbackTag[]

  @@unique([planId, reviewerId])
  @@index([planId])
  @@index([reviewerId])
  @@index([metUserId])
  @@index([attendanceStatus])
  @@index([createdAt])
}

model DatePlanFeedbackTag {
  id         String                @id @default(uuid()) @db.Uuid
  feedbackId String                @db.Uuid
  tag        DatePlanExperienceTag
  feedback   DatePlanFeedback      @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, tag])
  @@index([tag])
}

model DatePlanReport {
  id             String               @id @default(uuid()) @db.Uuid
  planId         String               @db.Uuid
  reporterId     String               @db.Uuid
  reportedUserId String               @db.Uuid
  reason         DatePlanReportReason
  comment        String?
  status         DatePlanReportStatus @default(PENDING)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  plan           DatePlan             @relation(fields: [planId], references: [id], onDelete: Cascade)
  reportedUser   User                 @relation("DatePlanReportedUser", fields: [reportedUserId], references: [id])
  reporter       User                 @relation("DatePlanReportReporter", fields: [reporterId], references: [id])

  @@index([planId])
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([reason])
  @@index([status])
  @@index([createdAt])
}

model DatePlanUserStats {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  totalDatePlan     Int      @default(0)
  balance           Int      @default(0)
  purchasedDataPlan Int      @default(0)
  weeklyLimit       Int      @default(0)
  totalDetePlanUsed Int      @default(0)
  lastResetAt       DateTime @default(now())
  nextResetAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DatePlanPurchase {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @db.Uuid
  quantity            Int
  amount              Float                 @default(0.00)
  paymentMethod       PurchasePaymentMethod
  paymentId           String?
  walletTransactionId String?               @db.Uuid
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  payment             Payment?              @relation(fields: [paymentId], references: [payment_id])
  user                User                  @relation(fields: [userId], references: [id])
  walletTransaction   WalletTransaction?    @relation(fields: [walletTransactionId], references: [id])
  transactions        DatePlanTransaction[]

  @@map("date_plan_purchases")
}

model DatePlanTransaction {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @db.Uuid
  type         DatePlanTransactionType
  quantity     Int
  balanceAfter Int
  purchaseId   String?                 @db.Uuid
  referenceId  String?
  description  String?
  createdAt    DateTime                @default(now())
  purchase     DatePlanPurchase?       @relation(fields: [purchaseId], references: [id])
  user         User                    @relation(fields: [userId], references: [id])

  @@map("date_plan_transactions")
}

model DatePlanUserBoost {
  id                   String                  @id @default(uuid()) @db.Uuid
  datePlanId           String                  @db.Uuid
  userId               String                  @db.Uuid
  boostOptionId        String                  @db.Uuid
  status               DatePlanUserBoostStatus @default(ACTIVE)
  startedAt            DateTime                @default(now())
  expiresAt            DateTime
  viewCount            Int                     @default(0)
  requestCount         Int                     @default(0)
  approvedRequestCount Int                     @default(0)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  boostOption          DatePlanBoostOption     @relation(fields: [boostOptionId], references: [id])
  datePlan             DatePlan                @relation(fields: [datePlanId], references: [id], onDelete: Cascade)
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([datePlanId])
  @@index([userId])
  @@index([boostOptionId])
  @@index([status])
  @@index([expiresAt])
  @@index([datePlanId, status])
}

model DatePlanBoost {
  id          String                @id @default(uuid()) @db.Uuid
  title       String
  description String?
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  options     DatePlanBoostOption[]
}

model DatePlanBoostOption {
  id                String              @id @default(uuid()) @db.Uuid
  boostId           String              @db.Uuid
  title             String
  durationHours     Int
  price             Decimal             @db.Decimal(10, 2)
  currency          String              @default("INR") @db.VarChar(10)
  isPopular         Boolean             @default(false)
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  boost             DatePlanBoost       @relation(fields: [boostId], references: [id], onDelete: Cascade)
  DatePlanUserBoost DatePlanUserBoost[]

  @@unique([boostId, durationHours])
  @@index([boostId])
  @@index([sortOrder])
}

model Conversation {
  id                    String                    @id @default(uuid()) @db.Uuid
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  match                 Boolean                   @default(false)
  matchPendingForUserId String?                   @db.Uuid
  messages              ChatMessage[]
  participants          ConversationParticipant[]

  @@index([updatedAt])
  @@index([matchPendingForUserId])
  @@index([match])
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())
  deletedAt      DateTime?
  clearedAt      DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @db.Uuid
  senderId       String                @db.Uuid
  content        String?
  messageType    MessageType           @default(TEXT)
  mediaUrl       String?
  metadata       Json?
  createdAt      DateTime              @default(now())
  deliveredAt    DateTime?
  readAt         DateTime?
  deletedAt      DateTime?
  roseId         String?               @unique @db.Uuid
  complimentId   String?               @unique @db.Uuid
  giftId         String?               @unique @db.Uuid
  eventId        String?               @db.Uuid
  datePlanId     String?               @db.Uuid
  compliment     UserCompliment?       @relation(fields: [complimentId], references: [id])
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  datePlan       DatePlan?             @relation("DatePlanChatMessages", fields: [datePlanId], references: [id])
  event          Event?                @relation(fields: [eventId], references: [id])
  gift           UserGift?             @relation(fields: [giftId], references: [id])
  rose           UserRose?             @relation(fields: [roseId], references: [id])
  sender         User                  @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  deletions      ChatMessageDeletion[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model ChatMessageDeletion {
  id        String      @id @default(uuid()) @db.Uuid
  messageId String      @db.Uuid
  userId    String      @db.Uuid
  deletedAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model UserReplyStats {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @db.Uuid
  medianReplyMinutes Int?
  sampleCount        Int      @default(0)
  recentSamples      Json?
  calculatedAt       DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @unique @db.Uuid
  balance      Decimal             @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletGooglePlayPurchase {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  productId           String
  orderId             String   @unique
  purchaseTokenHash   String   @unique
  amount              Decimal  @db.Decimal(10, 2)
  status              String   @default("PROCESSING")
  walletTransactionId String?  @unique @db.Uuid
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

model WalletTransaction {
  id                 String               @id @default(uuid()) @db.Uuid
  walletId           String               @db.Uuid
  amount             Decimal
  type               TransactionType
  status             TransactionStatus
  source             TransactionSource?
  referenceId        String?
  description        String?
  balanceBefore      Decimal
  balanceAfter       Decimal
  createdAt          DateTime             @default(now())
  BoostPurchase      BoostPurchase[]
  ComplimentPurchase ComplimentPurchase[]
  RosePurchase       RosePurchase[]
  gift               UserGift?
  wallet             Wallet               @relation(fields: [walletId], references: [id])
  DatePlanPurchase   DatePlanPurchase[]

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
}

model Waitlist {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @unique @db.Uuid
  waitlistNumber     Int             @unique
  plan               WaitlistPlan    @default(FREE)
  amountPaid         Decimal         @db.Decimal(10, 2)
  paymentStatus      PaymentStatus   @default(PENDING)
  paymentId          String?         @unique @db.Uuid
  launchBenefit      LaunchBenefit   @default(ONE_MONTH_PREMIUM)
  premiumActivated   Boolean         @default(false)
  premiumActivatedAt DateTime?
  source             WaitlistSource?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  payment            Payment?        @relation(fields: [paymentId], references: [id])
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([paymentStatus])
  @@map("waitlists")
}

model LaunchConfig {
  id                 String    @id @default(uuid()) @db.Uuid
  waitlistEnabled    Boolean   @default(true)
  appLaunched        Boolean   @default(false)
  launchDate         DateTime?
  originalPrice      Decimal   @default(799) @db.Decimal(10, 2)
  discountAmount     Decimal   @default(500) @db.Decimal(10, 2)
  finalPrice         Decimal   @default(299) @db.Decimal(10, 2)
  welcomeCoins       Int       @default(100)
  perks              Json?
  totalBenefitsValue Decimal?  @db.Decimal(10, 2)
  description        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model RewardConfig {
  id             String   @id @default(uuid()) @db.Uuid
  signupReward   Decimal  @default(100.00) @db.Decimal(10, 2)
  packageReward  Decimal  @default(500.00) @db.Decimal(10, 2)
  waitlistReward Decimal  @default(300.00) @db.Decimal(10, 2)
  title          String   @default("How Rewards Work") @db.VarChar(100)
  descriptions   Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("reward_config")
}

model GiftCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gifts     Gift[]

  @@map("gift_categories")
