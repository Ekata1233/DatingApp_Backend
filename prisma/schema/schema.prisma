generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "prismaSchemaFolder"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model User {
  id                               String                          @id @default(uuid()) @db.Uuid
  full_name                        String?                         @db.VarChar(100)
  email                            String?                         @unique @db.VarChar(255)
  phone_number                     String?                         @db.VarChar(20)
  is_phone_verified                Boolean                         @default(false)
  google_id                        String?                         @unique @db.VarChar(255)
  birth_date                       DateTime?                       @db.Date
  height                           Int?
  gender                           Gender?
  gender_option                    GenderOption?
  looking_for                      LookingFor?
  intentionId                      String?                         @db.Uuid
  onboarding_step                  String?                         @db.VarChar(20)
  next_step                        String?                         @db.VarChar(20)
  onboarding_completed             Boolean                         @default(false)
  last_active_at                   DateTime?
  device_token                     String?
  referralCode                     String?                         @unique @db.VarChar(20)
  badge_count                      Int                             @default(0)
  deleted_at                       DateTime?
  created_at                       DateTime                        @default(now())
  updated_at                       DateTime                        @updatedAt
  profile_completion               Int                             @default(0)
  looking_for_option               LookingForOption?
  account_status                   AccountStatus                   @default(ACTIVE)
  pause_reason                     String?                         @db.VarChar(255)
  paused_at                        DateTime?
  trust_score                      Int                             @default(0)
  active_days_7                    Int                             @default(0)
  activity_status                  ActivityStatus                  @default(RELAXED)
  show_activity                    Boolean                         @default(true)
  activityWatchers                 ActivityWatch[]                 @relation("ActivityTarget")
  activityWatching                 ActivityWatch[]                 @relation("ActivityWatcher")
  boostPurchases                   BoostPurchase[]
  boostTransactions                BoostTransaction[]
  callbackRequests                 CallbackRequest[]
  sentChatMessages                 ChatMessage[]                   @relation("ChatMessageSender")
  ChatMessageDeletion              ChatMessageDeletion[]
  complimentPurchases              ComplimentPurchase[]
  complimentTransactions           ComplimentTransaction[]
  conversationParticipants         ConversationParticipant[]
  hostedConfirmedDates             DateConfirmed[]                 @relation("ConfirmedDateHost")
  joinedConfirmedDates             DateConfirmed[]                 @relation("ConfirmedDateParticipant")
  datePlan                         DatePlan[]
  datePlanFeedbackAsMetUser        DatePlanFeedback[]              @relation("DatePlanFeedbackMetUser")
  datePlanFeedbackAsReviewer       DatePlanFeedback[]              @relation("DatePlanFeedbackReviewer")
  datePlanReportsReceived          DatePlanReport[]                @relation("DatePlanReportedUser")
  datePlanReportsMade              DatePlanReport[]                @relation("DatePlanReportReporter")
  datePlanRequests                 DatePlanRequest[]
  datePlanSkips                    DatePlanSkip[]
  DatePlanUserBoost                DatePlanUserBoost[]
  datePlanStats                    DatePlanUserStats?
  educationVerifications           EducationVerification[]
  employmentVerifications          EmploymentVerification?
  EventBooking                     EventBooking[]
  eventReviews                     EventReview[]
  receivedNotifications            Notification[]                  @relation("ReceivedNotifications")
  sentNotifications                Notification[]                  @relation("SentNotifications")
  rosePurchases                    RosePurchase[]
  roseTransactions                 RoseTransaction[]
  activityDays                     UserActivityDay[]
  answer                           UserAnswer[]
  blockedBy                        UserBlock[]                     @relation("UserBlocked")
  blockedUsers                     UserBlock[]                     @relation("UserBlocker")
  complimentsReceived              UserCompliment[]                @relation("ComplimentReceiver")
  complimentsSent                  UserCompliment[]                @relation("ComplimentSender")
  dailyFeedTargetViews             UserDailyFeedView[]             @relation("DailyFeedTarget")
  dailyFeedViews                   UserDailyFeedView[]             @relation("DailyFeedViewer")
  giftsReceived                    UserGift[]                      @relation("GiftReceiver")
  giftsSent                        UserGift[]                      @relation("GiftSender")
  mutedByUsers                     UserNotificationMute[]          @relation("NotificationMutedUser")
  notificationMutes                UserNotificationMute[]          @relation("NotificationMuteOwner")
  notificationSetting              UserNotificationSetting?
  payoutMethods                    UserPayoutMethod[]
  privacySettings                  UserPrivacySettings?
  receivedReferral                 UserReferral?                   @relation("ReferredUser")
  referralsMade                    UserReferral[]                  @relation("Referrer")
  referralStats                    UserReferralStats?
  replyStats                       UserReplyStats?
  reportsReceived                  UserReport[]                    @relation("ReportsReceived")
  reportsCreated                   UserReport[]                    @relation("ReportsCreated")
  rosesReceived                    UserRose[]                      @relation("RoseReceiver")
  rosesSent                        UserRose[]                      @relation("RoseSender")
  roseBalance                      UserRoseBalance?
  sessions                         UserSession[]
  wallet                           Wallet?
  actorEvents                      BoostEvent[]                    @relation("ActorUser")
  boostEvents                      BoostEvent[]                    @relation("BoostedUser")
  BoostReachUser                   BoostReachUser[]
  boostUsages                      BoostUsage[]
  datePlanPurchases                DatePlanPurchase[]
  datePlanTransactions             DatePlanTransaction[]
  governmentIdAttempts             GovernmentIdAttempt[]
  inAppPurchases                   InAppPurchase[]
  incomeVerification               IncomeVerification?
  manualGovernmentIdVerification   ManualGovernmentIdVerification?
  matchesAsUser1                   UserMatch[]                     @relation("MatchUser1")
  matchesAsUser2                   UserMatch[]                     @relation("MatchUser2")
  relationshipTagProposalsReceived RelationshipTagProposal[]       @relation("RelationshipTagProposalReceiver")
  relationshipTagProposalsSent     RelationshipTagProposal[]       @relation("RelationshipTagProposalSender")
  swipesGiven                      UserSwipe[]                     @relation("Swiper")
  swipesReceived                   UserSwipe[]                     @relation("TargetUser")
  about                            UserAbout?
  bio                              UserBio?
  boostStats                       UserBoostStats?
  userBoosts                       UserBoost[]
  complimentBalance                UserComplimentBalance?
  eduWork                          UserEduWork?                    @relation("UserEduWork")
  familyProfile                    UserFamilyProfile?              @relation("UserFamilyProfile")
  userPackages                     UserPackage[]
  photos                           UserPhoto[]
  UserPlanUsage                    UserPlanUsage[]
  profile                          UserProfile?
  userPrompts                      UserPrompt[]
  relationshipsAsUser1             UserRelationship[]              @relation("RelationshipUser1")
  relationshipsAsUser2             UserRelationship[]              @relation("RelationshipUser2")
  skills                           UserSkill[]
  verifications                    UserVerification[]
  intention                        IntentionOption?                @relation(fields: [intentionId], references: [id])
  waitlist                         Waitlist?

  @@index([phone_number])
  @@index([google_id])
  @@index([gender, created_at])
  @@index([created_at])
  @@index([account_status])
  @@index([deleted_at])
  @@map("users")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  isActive   Boolean   @default(true)
  deviceId   String?
  deviceName String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  logoutAt   DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

model UserActivityDay {
  userId String   @db.Uuid
  dayIst DateTime @db.Date
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dayIst])
  @@index([dayIst])
}

model ActivityReplyRate {
  id       String         @id @default(uuid()) @db.Uuid
  tag      ActivityStatus
  week     DateTime       @db.Date
  received Int            @default(0)
  replied  Int            @default(0)
  pct      Int?

  @@unique([tag, week])
}

model ActivityWatch {
  watcherId String   @db.Uuid
  targetId  String   @db.Uuid
  createdAt DateTime @default(now())
  target    User     @relation("ActivityTarget", fields: [targetId], references: [id], onDelete: Cascade)
  watcher   User     @relation("ActivityWatcher", fields: [watcherId], references: [id], onDelete: Cascade)

  @@id([watcherId, targetId])
  @@index([targetId])
}

model UserProfile {
  user_id            String                    @id @db.Uuid
  religionId         Int?
  communityId        Int?
  interested_in      Gender?
  sexual_orientation GenderOption?
  country            String?                   @db.VarChar(30)
  state              String?                   @db.VarChar(30)
  city               String?                   @db.VarChar(30)
  area               String?                   @db.VarChar(30)
  max_distance_km    Int?
  latitude           Decimal?                  @db.Decimal(10, 8)
  longitude          Decimal?                  @db.Decimal(11, 8)
  created_at         DateTime                  @default(now())
  updated_at         DateTime                  @updatedAt
  location           Unsupported("geography")?
  languages          UserLanguage[]
  community          Community?                @relation(fields: [communityId], references: [id])
  religion           Religion?                 @relation(fields: [religionId], references: [id])
  user               User                      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([religionId])
  @@index([communityId])
  @@index([interested_in])
  @@index([sexual_orientation])
  @@index([country, state, city])
  @@index([latitude, longitude])
  @@map("user_profiles")
}

model UserReferral {
  id             String         @id @default(uuid()) @db.Uuid
  referrerId     String         @db.Uuid
  referredUserId String         @unique @db.Uuid
  status         ReferralStatus @default(PENDING)
  signupReward   Decimal        @default(0) @db.Decimal(10, 2)
  purchaseReward Decimal        @default(0) @db.Decimal(10, 2)
  rewardedAt     DateTime?
  purchaseAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  referredUser   User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrer       User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([referrerId])
  @@index([referredUserId])
  @@index([createdAt])
}

model UserReferralStats {
  userId           String   @id @db.Uuid
  totalInvites     Int      @default(0)
  joinedUsers      Int      @default(0)
  pendingRewards   Int      @default(0)
  rewardedUsers    Int      @default(0)
  totalCoinsEarned Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserLanguage {
  userId     String      @db.Uuid
  languageId Int
  createdAt  DateTime    @default(now())
  language   Language    @relation(fields: [languageId], references: [id])
  user       UserProfile @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@id([userId, languageId])
  @@index([languageId])
  @@index([userId])
  @@map("user_languages")
}

model Religion {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(100)
  priority    Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  communities Community[]
  UserProfile UserProfile[]

  @@index([active])
  @@map("religions")
}

model Community {
  id           Int           @id @default(autoincrement())
  religionId   Int
  name         String        @db.VarChar(100)
  priority     Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  religion     Religion      @relation(fields: [religionId], references: [id], onDelete: Cascade)
  userProfiles UserProfile[]

  @@unique([religionId, name])
  @@index([religionId])
  @@index([active])
  @@map("communities")
}

model Language {
  id        Int            @id @default(autoincrement())
  name      String         @unique @db.VarChar(50)
  priority  Int            @default(0)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  users     UserLanguage[]

  @@index([active])
  @@map("languages")
}

model UserAbout {
  user_id                String                  @id @db.Uuid
  maritalStatus          MaritalStatus?
  childStatus            ChildStatus?
  numberOfChildren       NumberOfChildren?
  childLivingArrangement ChildLivingArrangement?
  livingSituation        LivingSituation?
  zodiac                 Zodiac?
  loveLanguage           LoveLanguage?
  communicationStyle     CommunicationStyle?
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  user                   User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([maritalStatus])
  @@index([childStatus])
  @@map("user_about")
}

model UserEduWork {
  userId           String          @id @db.Uuid
  highestEdu       EducationLevel?
  degree           String?         @db.VarChar(100)
  collegeName      String?         @db.VarChar(100)
  graduationYear   Int?
  professionId     Int?
  companyName      String?         @db.VarChar(100)
  employmentTypeId Int?
  experienceId     Int?
  ambitionId       Int?
  salaryRangeId    Int?
  bigDreams        String?         @db.VarChar(100)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  ambition         Ambition?       @relation(fields: [ambitionId], references: [id])
  employmentType   EmploymentType? @relation(fields: [employmentTypeId], references: [id])
  experience       Experience?     @relation(fields: [experienceId], references: [id])
  profession       Profession?     @relation(fields: [professionId], references: [id])
  salaryRange      SalaryRange?    @relation(fields: [salaryRangeId], references: [id])
  user             User            @relation("UserEduWork", fields: [userId], references: [id], onDelete: Cascade)

  @@index([highestEdu])
  @@index([degree])
  @@index([graduationYear])
  @@index([professionId])
  @@index([employmentTypeId])
  @@index([experienceId])
  @@index([ambitionId])
  @@index([salaryRangeId])
  @@map("user_edu_work")
}

model UserFamilyProfile {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @unique @db.Uuid
  familyStatusId       Int?
  familyTypeId         Int?
  fatherOccupationId   Int?
  fatherOrganisationId Int?
  motherOccupationId   Int?
  motherOrganisationId Int?
  familyHomeId         Int?
  nativePlaceId        Int?
  familyIncomeId       Int?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  familyHome           MasterValue?  @relation("FamilyHome", fields: [familyHomeId], references: [id])
  familyIncome         FamilyIncome? @relation(fields: [familyIncomeId], references: [id])
  familyStatus         MasterValue?  @relation("FamilyStatus", fields: [familyStatusId], references: [id])
  familyType           MasterValue?  @relation("FamilyType", fields: [familyTypeId], references: [id])
  fatherOccupation     MasterValue?  @relation("FatherOccupation", fields: [fatherOccupationId], references: [id])
  fatherOrganisation   MasterValue?  @relation("FatherOrganisation", fields: [fatherOrganisationId], references: [id])
  motherOccupation     MasterValue?  @relation("MotherOccupation", fields: [motherOccupationId], references: [id])
  motherOrganisation   MasterValue?  @relation("MotherOrganisation", fields: [motherOrganisationId], references: [id])
  nativePlace          MasterValue?  @relation("NativePlace", fields: [nativePlaceId], references: [id])
  user                 User          @relation("UserFamilyProfile", fields: [userId], references: [id], onDelete: Cascade)
  siblings             UserSibling[]

  @@index([familyStatusId])
  @@index([familyTypeId])
  @@index([fatherOccupationId])
  @@index([motherOccupationId])
  @@index([familyHomeId])
  @@index([nativePlaceId])
  @@index([familyIncomeId])
  @@map("user_family_profiles")
}

model UserSibling {
  id              String            @id @default(uuid()) @db.Uuid
  familyProfileId String            @db.Uuid
  siblingTypeId   Int
  maritalId       Int?
  occupationId    Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  familyProfile   UserFamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  marital         MasterValue?      @relation("SiblingMarital", fields: [maritalId], references: [id])
  occupation      MasterValue?      @relation("SiblingOccupation", fields: [occupationId], references: [id])
  siblingType     MasterValue       @relation("SiblingType", fields: [siblingTypeId], references: [id])

  @@map("user_siblings")
}

model MasterCategory {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  values    MasterValue[]

  @@map("master_categories")
}

model MasterValue {
  id                  Int                 @id @default(autoincrement())
  categoryId          Int
  value               String
  priority            Int                 @default(0)
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  category            MasterCategory      @relation(fields: [categoryId], references: [id])
  familyHomes         UserFamilyProfile[] @relation("FamilyHome")
  familyStatuses      UserFamilyProfile[] @relation("FamilyStatus")
  familyTypes         UserFamilyProfile[] @relation("FamilyType")
  fatherOccupations   UserFamilyProfile[] @relation("FatherOccupation")
  fatherOrganisations UserFamilyProfile[] @relation("FatherOrganisation")
  motherOccupations   UserFamilyProfile[] @relation("MotherOccupation")
  motherOrganisations UserFamilyProfile[] @relation("MotherOrganisation")
  nativePlaces        UserFamilyProfile[] @relation("NativePlace")
  siblingMaritals     UserSibling[]       @relation("SiblingMarital")
  siblingOccupations  UserSibling[]       @relation("SiblingOccupation")
  siblingTypes        UserSibling[]       @relation("SiblingType")

  @@index([categoryId])
  @@map("master_values")
}

model FamilyIncome {
  id           Int                 @id @default(autoincrement())
  title        String              @db.VarChar(100)
  minAmount    Int?
  maxAmount    Int?
  priority     Int                 @default(0)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  userProfiles UserFamilyProfile[]

  @@map("family_income")
}

model Profession {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userEduWorks UserEduWork[]

  @@map("professions")
}

model EmploymentType {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userEduWorks UserEduWork[]

  @@map("employment_types")
}

model Experience {
  id           Int           @id @default(autoincrement())
  title        String        @unique
  sortOrder    Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userEduWorks UserEduWork[]

  @@map("experiences")
}

model Ambition {
  id           Int           @id @default(autoincrement())
  title        String        @unique
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userEduWorks UserEduWork[]

  @@map("ambitions")
}

model SalaryRange {
  id           Int           @id @default(autoincrement())
  title        String        @unique
  minSalary    Int?
  maxSalary    Int?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userEduWorks UserEduWork[]

  @@map("salary_ranges")
}

model Skill {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique @db.VarChar(100)
  slug      String      @unique @db.VarChar(100)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  users     UserSkill[]

  @@index([name])
  @@map("skills")
}

model UserSkill {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  skillId   String   @db.Uuid
  createdAt DateTime @default(now())
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

model Question {
  id         String           @id @default(uuid()) @db.Uuid
  key        String           @unique
  title      String
  category   QuestionCategory
  isMulti    Boolean          @default(false)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  screen     QuestionScreen
  options    QuestionOption[]
  answers    UserAnswer[]
}

model QuestionOption {
  id          String       @id @default(uuid())
  question_id String       @db.Uuid
  value       String
  label       String
  created_at  DateTime     @default(now())
  question    Question     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answers     UserAnswer[]

  @@index([question_id])
}

model UserAnswer {
  id          String         @id @default(uuid()) @db.Uuid
  user_id     String         @db.Uuid
  question_id String         @db.Uuid
  option_id   String
  description String?
  created_at  DateTime       @default(now())
  option      QuestionOption @relation(fields: [option_id], references: [id], onDelete: Cascade)
  question    Question       @relation(fields: [question_id], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id, option_id])
  @@index([user_id])
  @@index([question_id])
  @@index([option_id])
}

model UserPhoto {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  is_primary Boolean   @default(false)
  order      Int?
  created_at DateTime  @default(now())
  media_type MediaType @default(IMAGE)
  media_url  String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_photos")
}

model UserBio {
  user_id    String   @id @db.Uuid
  bio        String?  @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_bio")
}

model UserPrompt {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  promptId     String   @db.Uuid
  answer       String   @db.VarChar(300)
  displayOrder Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  prompt       Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([userId])
  @@index([promptId])
  @@map("user_prompts")
}

model PromptCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  priority    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  prompts     Prompt[]

  @@map("prompt_categories")
}

model Prompt {
  id          String           @id @default(uuid()) @db.Uuid
  categoryId  String           @db.Uuid
  question    String           @db.VarChar(255)
  active      Boolean          @default(true)
  priority    Int              @default(0)
  maxLength   Int              @default(200)
  visibility  PromptVisibility @default(EVERYONE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    PromptCategory   @relation(fields: [categoryId], references: [id])
  userPrompts UserPrompt[]

  @@index([categoryId])
  @@index([active])
  @@map("prompts")
}

model UserVerification {
  id                             String                          @id @default(uuid()) @db.Uuid
  userId                         String                          @db.Uuid
  type                           VerificationType
  status                         VerificationStatus              @default(NOT_STARTED)
  points                         Int                             @default(0)
  maxPoints                      Int
  governmentIdType               GovernmentIdType?
  startedAt                      DateTime?
  verifiedAt                     DateTime?
  expiresAt                      DateTime?
  provider                       String?
  providerRef                    String?
  rejectionReason                String?
  metadata                       Json?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  governmentIdPhotoKey           String?
  verifiedName                   String?
  educationVerification          EducationVerification?
  employmentVerifications        EmploymentVerification?
  attempts                       GovernmentIdAttempt[]
  incomeVerification             IncomeVerification?
  manualGovernmentIdVerification ManualGovernmentIdVerification?
  user                           User                            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@map("user_verifications")
}

model GovernmentIdAttempt {
  id                String                    @id @default(uuid()) @db.Uuid
  userId            String                    @db.Uuid
  verificationId    String                    @db.Uuid
  documentType      GovernmentIdType
  status            GovernmentIdAttemptStatus @default(INITIATING)
  transactionId     String?                   @unique
  referenceId       String?                   @unique
  callbackStateHash String?                   @unique
  providerRequestId String?
