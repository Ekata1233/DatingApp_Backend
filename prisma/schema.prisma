model DatePlan {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @db.Uuid
  // Step 1
  activityId   String  @db.Uuid
  title        String?
  quickTitleId String? @db.Uuid
  note         String?
  photoUrl     String?

  // Step 2
  venueName    String?
  venueAddress String?
  venueLat     Float?
  venueLng     Float?

  // Step 3
  duration            Int?
  whoPaysId           String?    @db.Uuid
  participantLimit    Int?
  joinRequestGenderId String?    @db.Uuid
  visibilityId        String?    @db.Uuid
  status              PlanStatus @default(DRAFT)
  eventDateTime       DateTime?
  expiresAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations

  user User @relation(fields: [userId], references: [id])

  activity DatePlanOption @relation("PlanActivity", fields: [activityId], references: [id])

  quickTitle DatePlanOption? @relation("PlanQuickTitle", fields: [quickTitleId], references: [id])

  whoPays DatePlanOption? @relation("PlanWhoPays", fields: [whoPaysId], references: [id])

  joinRequestGender DatePlanOption? @relation("PlanJoinRequestGender", fields: [joinRequestGenderId], references: [id])

  visibility DatePlanOption? @relation("PlanVisibility", fields: [visibilityId], references: [id])

  vibes         DatePlanVibe[]
  requests      DatePlanRequest[]
  skips         DatePlanSkip[]
  DateConfirmed DateConfirmed?

  @@index([userId])
  @@index([activityId])
  @@index([status])
  @@index([createdAt])
}

model DatePlanVibe {
  id     String @id @default(uuid())
