generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String          @id @default(uuid()) @db.Uuid
  full_name               String?         @db.VarChar(100)
  email                   String?         @unique @db.VarChar(255)
  phone_number            String?         @unique @db.VarChar(20)
  is_phone_verified       Boolean         @default(false)
  google_id               String?         @unique @db.VarChar(255)
  looking_for             LookingFor?
  birth_date              DateTime?       @db.Date
  height                  Int?
  gender                  String?         @db.VarChar(20)
  onboarding_step         String?         @db.VarChar(20)
  next_step               String?         @db.VarChar(20)
  onboarding_completed    Boolean         @default(false)
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt
  profile                 UserProfile?
  about                   UserAbout?
  eduWork                 UserEduWork?    @relation("UserEduWork")
  @@index([phone_number])
  @@index([google_id])
  @@index([looking_for])
  @@index([gender, created_at])
  @@index([created_at])
  @@map("users")
}

model UserProfile {
  user_id                 String    @id @db.Uuid
  religion                String?   @db.VarChar(50)
  community               String?   @db.VarChar(50)
  interested_in           String?   @db.VarChar(30)
  sexual_orientation      String?   @db.VarChar(50)
  country                 String?   @db.VarChar(30)
  state                   String?   @db.VarChar(30)
  city                    String?   @db.VarChar(30)
  max_distance_km         Int?
  latitude                Decimal?  @db.Decimal(10,8)
  longitude               Decimal?  @db.Decimal(11,8)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([religion])
  @@index([community])
  @@index([interested_in])
  @@index([sexual_orientation])
  @@index([country])
  @@index([state])
  @@index([city])
  @@index([latitude, longitude])
  @@map("user_profiles")
}

model UserAbout {
  user_id                    String    @id @db.Uuid
  maritalStatus              MaritalStatus?
  childStatus                ChildStatus?
  numberOfChildren           NumberOfChildren?
  childLivingArrangement     ChildLivingArrangement?
  livingSituation            LivingSituation?
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([maritalStatus])
  @@index([childStatus])
  @@map("user_about")
}

enum LookingFor {
  DATE_TO_MARRY
  DATING
  MATURE_CONNECTION
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
  ANNULLED
}

// Enum for child-related options
enum ChildStatus {
  YES
  NO
  PREFER_NOT_TO_SAY
}

// Enum for number of children
enum NumberOfChildren {
  ONE
  TWO
  THREE
  FOUR
  FIVE_PLUS
}

// Enum for child living arrangement
enum ChildLivingArrangement {
  YES
  NO
  SOMETIME
}

// Enum for current living situation
enum LivingSituation {
  OWN_HOME
  LIVING_ALONE
  WITH_CHILDREN
  WITH_FAMILY
  RENTED_HOME
  SENIOR_LIVING_COMMUNITY
  OTHER
}

model UserEduWork {
  userId        String   @id @db.Uuid

  // Controlled enums instead of string
  highestEdu    EducationType
  collegeName   String?  @db.VarChar(100)

  incomeRange   IncomeRangeType
  minIncome     Int?
  maxIncome     Int?

  workingWith   WorkingWith?
  workingAs     WorkingAs?
  companyName   String?  @db.VarChar(100)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User     @relation("UserEduWork", fields: [userId], references: [id], onDelete: Cascade)

  @@index([highestEdu])
  @@index([incomeRange])
  @@index([workingWith])
  @@index([highestEdu, incomeRange, workingWith])
  @@index([minIncome, maxIncome])

  @@map("user_edu_work")
}

enum EducationType {
  BCOM
  CA_CPA
  CS
  BSC_BFIN
  MCOM
  MENG
  MS_ENGINEERING
  AE
  AET
  OTHER
}
enum IncomeRangeType {
  UPTO_1_LAKH
  INR_1_TO_2_LAKH
  INR_2_TO_4_LAKH
  INR_4_TO_7_LAKH
  INR_10_TO_15_LAKH
  INR_15_TO_20_LAKH
  INR_20_TO_30_LAKH
  INR_30_TO_50_LAKH
  INR_50_TO_75_LAKH
  ABOVE_75_LAKH
}
enum WorkingWith {
  PRIVATE_COMPANY
  GOVERNMENT
  CIVIL_SERVICES
  SELF_EMPLOYED
  NOT_WORKING
}

enum WorkingAs {
  SOFTWARE_ENGINEER
  DOCTOR
  TEACHER
  BUSINESS_OWNER
  OTHER
}

