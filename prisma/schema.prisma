model Event {
  id        String      @id @default(uuid()) @db.Uuid
  //---------------------------------
  // Step 1
  //---------------------------------
  eventType Type?
  title     String?
  status    EventStatus @default(DRAFT)

  //---------------------------------
  // Step 2
  //---------------------------------
  city            String?
  eventPartnerId  String?
  eventPartner    EventPartner? @relation(fields: [eventPartnerId], references: [id])
  officialPartner Boolean       @default(false)

  //---------------------------------
  // Step 3
  //---------------------------------
  eventDate   DateTime?
  startTime   String?
  endTime     String?
  venueName   String?
  fullAddress String?   @db.Text
  latitude    Float?
  longitude   Float?

  //---------------------------------
  // Step 4
  //--------------------------------
  entryPrice  Decimal?     @db.Decimal(10, 2)
  capacity    Int?
  minAge      Int?
  maxAge      Int?
  genderMix   GenderMix?
  eventIntent EventIntent?

  //---------------------------------
  // Step 5
  //---------------------------------
  heroImage     String?
  galleryImages EventGallery[]
  aboutEvent    String?          @db.Text
  amenities     EventAmenity[]
  itinerary     EventItinerary[]
  whyShouldCome EventWhyCome[]

  //---------------------------------
  // Step 6
  //---------------------------------
  safetyFeatures  EventSafety[]
  dressCode       DressCode?
  refundWindow    Int?
  termsConditions String?       @db.Text

  //---------------------------------
  // Step Progress
  //--------------------------------
  currentStep    Int       @default(1)
  basicsDone     Boolean   @default(false)
  hostDone       Boolean   @default(false)
  venueDone      Boolean   @default(false)
  ticketDone     Boolean   @default(false)
  experienceDone Boolean   @default(false)
  safetyDone     Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([city])
  @@index([eventDate])
  @@index([currentStep])
  @@index([eventPartnerId])
}

