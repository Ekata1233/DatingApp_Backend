generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String             @id @default(uuid()) @db.Uuid
  full_name               String?            @db.VarChar(100)
  email                   String?            @unique @db.VarChar(255)
  phone_number            String?            @unique @db.VarChar(20)
  is_phone_verified       Boolean            @default(false)
  google_id               String?            @unique @db.VarChar(255)
  birth_date              DateTime?          @db.Date
  height                  Int?
  gender                  String?            @db.VarChar(20)
  looking_for             LookingFor?
  onboarding_step         String?            @db.VarChar(20)
  next_step               String?            @db.VarChar(20)
  onboarding_completed    Boolean            @default(false)
  last_active_at          DateTime?
  deleted_at              DateTime?
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt
  current_subscription_id String?            @unique
  profile_completion      Int                @default(0)
  looking_for_option      LookingForOption?
  answer                  UserAnswer[]
  subscriptions           UserSubscription[] @relation("UserSubscriptions")
  matchesAsUser1          UserMatch[]        @relation("MatchUser1")
  matchesAsUser2          UserMatch[]        @relation("MatchUser2")
  swipesGiven             UserSwipe[]        @relation("Swiper")
  swipesReceived          UserSwipe[]        @relation("TargetUser")
  about                   UserAbout?
  bio                     UserBio?
  eduWork                 UserEduWork?       @relation("UserEduWork")
  photos                  UserPhoto[]
  profile                 UserProfile?
  currentSubscription     UserSubscription?  @relation("CurrentSubscription", fields: [current_subscription_id], references: [id])

  @@index([phone_number])
  @@index([google_id])
  @@index([gender, created_at])
  @@index([created_at])
  @@map("users")
}

model UserProfile {
  user_id            String   @id @db.Uuid
  religion           String?  @db.VarChar(50)
  community          String?  @db.VarChar(50)
  interested_in      String?  @db.VarChar(30)
  sexual_orientation String?  @db.VarChar(50)
  country            String?  @db.VarChar(30)
  state              String?  @db.VarChar(30)
  city               String?  @db.VarChar(30)
  max_distance_km    Int?
  latitude           Decimal? @db.Decimal(10, 8)
  longitude          Decimal? @db.Decimal(11, 8)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([religion])
  @@index([community])
  @@index([interested_in])
  @@index([sexual_orientation])
  @@index([country, state, city])
  @@index([latitude, longitude])
  @@map("user_profiles")
}

model UserAbout {
  user_id                String                  @id @db.Uuid
  maritalStatus          MaritalStatus?
  childStatus            ChildStatus?
  numberOfChildren       NumberOfChildren?
  childLivingArrangement ChildLivingArrangement?
  livingSituation        LivingSituation?
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  user                   User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([maritalStatus])
  @@index([childStatus])
  @@map("user_about")
}

model UserEduWork {
  userId      String           @id @db.Uuid
  collegeName String?          @db.VarChar(100)
  incomeRange IncomeRangeType?
  minIncome   Int?
  maxIncome   Int?
  workingWith WorkingWith?
  companyName String?          @db.VarChar(100)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  highestEdu  String?          @db.VarChar(100)
  workingAs   String?          @db.VarChar(100)
  user        User             @relation("UserEduWork", fields: [userId], references: [id], onDelete: Cascade)

  @@index([highestEdu])
  @@index([incomeRange])
  @@index([workingWith])
  @@index([highestEdu, incomeRange, workingWith])
  @@index([minIncome, maxIncome])
  @@map("user_edu_work")
}

model Question {
  id         String           @id @default(uuid()) @db.Uuid
  key        String           @unique
  title      String
  category   QuestionCategory
  isMulti    Boolean          @default(false)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  screen     QuestionScreen
  options    QuestionOption[]
  answers    UserAnswer[]
}

model QuestionOption {
  id          String       @id @default(uuid())
  question_id String       @db.Uuid
  value       String
  label       String
  created_at  DateTime     @default(now())
  question    Question     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answers     UserAnswer[]

  @@index([question_id])
}

model UserAnswer {
  id          String         @id @default(uuid()) @db.Uuid
  user_id     String         @db.Uuid
  question_id String         @db.Uuid
  option_id   String
  created_at  DateTime       @default(now())
  option      QuestionOption @relation(fields: [option_id], references: [id], onDelete: Cascade)
  question    Question       @relation(fields: [question_id], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id, option_id])
  @@index([user_id])
  @@index([question_id])
  @@index([option_id])
}

model UserPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  is_primary Boolean  @default(false)
  order      Int?
  created_at DateTime @default(now())
  media_type String   @default("image")
  media_url  String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_photos")
}

model UserBio {
  user_id    String   @id @db.Uuid
  bio        String?  @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_bio")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model UserReport {
  id         String   @id @default(uuid())
  reporterId String
  reportedId String
  createdAt  DateTime @default(now())

  @@unique([reporterId, reportedId])
}

model UserSwipe {
  id           String      @id @default(uuid()) @db.Uuid
  swiperId     String      @db.Uuid
  targetUserId String      @db.Uuid
  action       SwipeAction
  isMutual     Boolean     @default(false)
  created_at   DateTime    @default(now())
  swiper       User        @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  targetUser   User        @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetUserId])
  @@index([swiperId])
  @@index([targetUserId])
  @@index([action])
  @@index([created_at])
  @@index([swiperId, action])
  @@index([targetUserId, action])
  @@map("swipes")
}

model UserMatch {
  id              String    @id @default(uuid()) @db.Uuid
  user1Id         String    @db.Uuid
  user2Id         String    @db.Uuid
  matched_at      DateTime  @default(now())
  last_message_at DateTime?
  is_active       Boolean   @default(true)
  is_deleted      Boolean   @default(false)
  user1           User      @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User      @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([matched_at])
  @@index([last_message_at])
  @@index([is_active])
  @@index([user1Id, is_active])
  @@index([user2Id, is_active])
  @@map("matches")
}

model Package {
  id            String             @id @default(uuid())
  name          PackageType
  title         String
  description   String?
  is_active     Boolean            @default(true)
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  subscriptions UserSubscription[]
  options       PackageOption[]

  @@map("packages")
}

model PackageOption {
  id               String             @id @default(uuid())
  package_id       String
  label            String
  boostCount       Int
  pricePerBoost    Float
  discounted_price Float?
  discount_percent Int?
  totalPrice       Float
  is_best_value    Boolean            @default(false)
  is_popular       Boolean            @default(false)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  subscriptions    UserSubscription[]
  package          Package            @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@map("package_options")
}

model UserSubscription {
  id                String             @id @default(uuid())
  userId            String             @db.Uuid
  started_at        DateTime
  expires_at        DateTime
  daily_swipe_count Int                @default(0)
  daily_like_count  Int                @default(0)
  last_reset_at     DateTime           @default(now())
  created_at        DateTime           @default(now())
  boostsRemaining   Int?
  boostsTotal       Int?
  packageId         String
  packageOptionId   String
  pricePaid         Float
  status            SubscriptionStatus
  package           Package            @relation(fields: [packageId], references: [id])
  packageOption     PackageOption      @relation(fields: [packageOptionId], references: [id])
  user              User               @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  currentForUser    User?              @relation("CurrentSubscription")

  @@index([userId])
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  subscriptionId String?
  amount         Float
  currency       String
  provider       String
  payment_id     String
  status         String
  created_at     DateTime @default(now())
}

enum PackageType {
  BOOST
  PRIMETIME
  SUPER
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LookingFor {
  DATE_TO_MARRY
  DATING
  MATURE_CONNECTION
}

enum LookingForOption {
  LONG_TERM
  SHORT_TERM
  NEW_FRIENDS
  CASUAL
  COMPANIONSHIP
  LIFE_PARTNER
  TRAVEL_PARTNER
  EMOTIONAL_SUPPORT
  FRIENDSHIP_FIRST
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
  ANNULLED
}

enum ChildStatus {
  YES
  NO
  PREFER_NOT_TO_SAY
}

enum NumberOfChildren {
  ONE
  TWO
  THREE
  FOUR
  FIVE_PLUS
}

enum ChildLivingArrangement {
  YES
  NO
  SOMETIME
}

enum LivingSituation {
  OWN_HOME
  LIVING_ALONE
  WITH_CHILDREN
  WITH_FAMILY
  RENTED_HOME
  SENIOR_LIVING_COMMUNITY
  OTHER
}

enum IncomeRangeType {
  UPTO_1_LAKH
  INR_1_TO_2_LAKH
  INR_2_TO_4_LAKH
  INR_4_TO_7_LAKH
  INR_10_TO_15_LAKH
  INR_15_TO_20_LAKH
  INR_20_TO_30_LAKH
  INR_30_TO_50_LAKH
  INR_50_TO_75_LAKH
  ABOVE_75_LAKH
}

enum WorkingWith {
  PRIVATE_COMPANY
  GOVERNMENT
  CIVIL_SERVICES
  SELF_EMPLOYED
  NOT_WORKING
}

enum QuestionCategory {
  DATING
  DATE_TO_MARRY
  MATURE_CONNECTION
}

enum QuestionScreen {
  LIFESTYLE
  REAL_U_MATTERS
  THINGS_U_LOVE
  INTEREST_HOBBY
  DREAM_PLAN
  HEALTH_WELLNESS
}

enum SwipeAction {
  LIKE
  PASS
  SUPERLIKE
}
