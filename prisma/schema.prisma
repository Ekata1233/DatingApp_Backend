generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String            @id @default(uuid()) @db.Uuid
  full_name            String?           @db.VarChar(100)
  email                String?           @unique @db.VarChar(255)
  phone_number         String?           @unique @db.VarChar(20)
  is_phone_verified    Boolean           @default(false)
  google_id            String?           @unique @db.VarChar(255)
  birth_date           DateTime?         @db.Date
  height               Int?
  gender               Gender?
  gender_option        GenderOption?
  looking_for          LookingFor?
  onboarding_step      String?           @db.VarChar(20)
  next_step            String?           @db.VarChar(20)
  onboarding_completed Boolean           @default(false)
  last_active_at       DateTime?
  device_token         String?
  badge_count          Int               @default(0)
  deleted_at           DateTime?
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  profile_completion   Int               @default(0)
  looking_for_option   LookingForOption?
  answer               UserAnswer[]
  matchesAsUser1       UserMatch[]       @relation("MatchUser1")
  matchesAsUser2       UserMatch[]       @relation("MatchUser2")
  swipesGiven          UserSwipe[]       @relation("Swiper")
  swipesReceived       UserSwipe[]       @relation("TargetUser")
  about                UserAbout?
  bio                  UserBio?
  eduWork              UserEduWork?      @relation("UserEduWork")
  skills               UserSkill[]
  photos               UserPhoto[]
  profile              UserProfile?
  userBoosts           UserBoost[]
  boostUsages          BoostUsage[]
  userPackages         UserPackage[]
  boostEvents          BoostEvent[]      @relation("BoostedUser")
  actorEvents          BoostEvent[]      @relation("ActorUser")
  boostStats           UserBoostStats?
  DatePlan             DatePlan[]
  datePlanRequests     DatePlanRequest[]

  @@index([phone_number])
  @@index([google_id])
  @@index([gender, created_at])
  @@index([created_at])
  @@map("users")
}

model UserProfile {
  user_id            String   @id @db.Uuid
  religion           String?  @db.VarChar(50)
  community          String?  @db.VarChar(50)
  interested_in      String?  @db.VarChar(30)
  sexual_orientation String?  @db.VarChar(50)
  country            String?  @db.VarChar(30)
  state              String?  @db.VarChar(30)
  city               String?  @db.VarChar(30)
  max_distance_km    Int?
  latitude           Decimal? @db.Decimal(10, 8)
  longitude          Decimal? @db.Decimal(11, 8)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([religion])
  @@index([community])
  @@index([interested_in])
  @@index([sexual_orientation])
  @@index([country, state, city])
  @@index([latitude, longitude])
  @@map("user_profiles")
}

model UserAbout {
  user_id                String                  @id @db.Uuid
  maritalStatus          MaritalStatus?
  childStatus            ChildStatus?
  numberOfChildren       NumberOfChildren?
  childLivingArrangement ChildLivingArrangement?
  livingSituation        LivingSituation?
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  user                   User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([maritalStatus])
  @@index([childStatus])
  @@map("user_about")
}

model UserEduWork {
  userId String @id @db.Uuid

  // Education
  highestEdu     String? @db.VarChar(100)
  degree         String? @db.VarChar(100)
  collegeName    String? @db.VarChar(100)
  graduationYear Int?

  // Work
  workingWith WorkingWith?
  workingAs   String?      @db.VarChar(100)
  companyName String?      @db.VarChar(100)
  workStyle   WorkStyle?

  // Income
  incomeRange IncomeRangeType?
  minIncome   Int?
  maxIncome   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserEduWork", fields: [userId], references: [id], onDelete: Cascade)

  @@index([highestEdu])
  @@index([degree])
  @@index([graduationYear])
  @@index([workingWith])
  @@index([workStyle])
  @@index([incomeRange])
  @@index([highestEdu, incomeRange, workingWith])
  @@index([minIncome, maxIncome])
  @@map("user_edu_work")
}

enum WorkStyle {
  REMOTE
  HYBRID
  OFFICE
  FREELANCER
  BUSINESS_OWNER
}

model Skill {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserSkill[]

  @@index([name])
  @@map("skills")
}

model UserSkill {
  id String @id @default(uuid()) @db.Uuid

  userId  String @db.Uuid
  skillId String @db.Uuid

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

model Question {
  id         String           @id @default(uuid()) @db.Uuid
  key        String           @unique
  title      String
  category   QuestionCategory
  isMulti    Boolean          @default(false)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  screen     QuestionScreen
  options    QuestionOption[]
  answers    UserAnswer[]
}

model QuestionOption {
  id          String       @id @default(uuid())
  question_id String       @db.Uuid
  value       String
  label       String
  created_at  DateTime     @default(now())
  question    Question     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answers     UserAnswer[]

  @@index([question_id])
}

model UserAnswer {
  id          String         @id @default(uuid()) @db.Uuid
  user_id     String         @db.Uuid
  question_id String         @db.Uuid
  option_id   String
  created_at  DateTime       @default(now())
  option      QuestionOption @relation(fields: [option_id], references: [id], onDelete: Cascade)
  question    Question       @relation(fields: [question_id], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id, option_id])
  @@index([user_id])
  @@index([question_id])
  @@index([option_id])
}

model UserPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  is_primary Boolean  @default(false)
  order      Int?
  created_at DateTime @default(now())
  media_type String   @default("image")
  media_url  String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_photos")
}

model UserBio {
  user_id    String   @id @db.Uuid
  bio        String?  @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_bio")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model UserReport {
  id         String   @id @default(uuid())
  reporterId String
  reportedId String
  createdAt  DateTime @default(now())

  @@unique([reporterId, reportedId])
}

model UserSwipe {
  id           String      @id @default(uuid()) @db.Uuid
  swiperId     String      @db.Uuid
  targetUserId String      @db.Uuid
  action       SwipeAction
  isMutual     Boolean     @default(false)
  created_at   DateTime    @default(now())
  swiper       User        @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  targetUser   User        @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetUserId])
  @@index([swiperId])
  @@index([targetUserId])
  @@index([action])
  @@index([created_at])
  @@index([swiperId, action])
  @@index([targetUserId, action])
  @@map("swipes")
}

model UserMatch {
  id              String    @id @default(uuid()) @db.Uuid
  user1Id         String    @db.Uuid
  user2Id         String    @db.Uuid
  matched_at      DateTime  @default(now())
  last_message_at DateTime?
  is_active       Boolean   @default(true)
  is_deleted      Boolean   @default(false)
  user1           User      @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User      @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([matched_at])
  @@index([last_message_at])
  @@index([is_active])
  @@index([user1Id, is_active])
  @@index([user2Id, is_active])
  @@map("matches")
}

model Boost {
  id          String        @id @default(uuid()) @db.Uuid
  name        BoostType     @unique
  title       String
  description String?
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  options     BoostOption[]
  userBoosts  UserBoost[]

  @@map("boosts")
}

model BoostOption {
  id               String      @id @default(uuid()) @db.Uuid
  boost_id         String      @db.Uuid
  label            String
  boostCount       Int
  timePerBoost     Int
  pricePerBoost    Decimal     @db.Decimal(10, 2)
  discounted_price Decimal     @db.Decimal(10, 2)
  discount_percent Int?
  totalPrice       Decimal     @db.Decimal(10, 2)
  is_best_value    Boolean     @default(false)
  is_popular       Boolean     @default(false)
  is_active        Boolean     @default(true)
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  boost            Boost       @relation(fields: [boost_id], references: [id], onDelete: Cascade)
  userBoosts       UserBoost[]

  @@index([boost_id])
  @@map("boost_options")
}

model UserBoost {
  id String @id @default(uuid()) @db.Uuid

  user_id          String    @db.Uuid
  boost_id         String    @db.Uuid
  boost_option_id  String    @db.Uuid
  total_boosts     Int
  remaining_boosts Int
  start_at         DateTime  @default(now())
  expires_at       DateTime?
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  boost       Boost       @relation(fields: [boost_id], references: [id])
  boostOption BoostOption @relation(fields: [boost_option_id], references: [id])

  usages BoostUsage[]

  @@index([user_id])
  @@index([boost_id])
  @@map("user_boosts")
}

model BoostUsage {
  id String @id @default(uuid()) @db.Uuid

  user_boost_id String    @db.Uuid
  user_id       String    @db.Uuid
  duration      Int // minutes
  started_at    DateTime  @default(now())
  ended_at      DateTime?
  is_active     Boolean   @default(true)

  total_views     Int @default(0)
  total_likes     Int @default(0)
  total_interests Int @default(0)
  total_reach     Int @default(0)

  created_at DateTime @default(now())

  userBoost   UserBoost    @relation(fields: [user_boost_id], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  boostEvents BoostEvent[]

  @@index([user_id])
  @@index([user_boost_id])
  @@map("boost_usages")
}

model UserBoostStats {
  id      String @id @default(uuid()) @db.Uuid
  user_id String @unique @db.Uuid

  total_views     Int @default(0)
  total_likes     Int @default(0)
  total_interests Int @default(0)
  total_reach     Int @default(0)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_boost_stats")
}

model BoostEvent {
  id String @id @default(uuid()) @db.Uuid

  boost_usage_id String @db.Uuid
  user_id        String @db.Uuid // boosted user
  actor_id       String @db.Uuid // who performed action

  event_type EventType
  created_at DateTime  @default(now())

  boostUsage BoostUsage @relation(fields: [boost_usage_id], references: [id], onDelete: Cascade)

  user  User @relation("BoostedUser", fields: [user_id], references: [id], onDelete: Cascade)
  actor User @relation("ActorUser", fields: [actor_id], references: [id], onDelete: Cascade)

  @@index([boost_usage_id])
  @@index([user_id])
  @@index([actor_id])
  @@map("boost_events")
}

enum EventType {
  VIEW
  LIKE
  INTEREST
  REACH
}

model Package {
  id          String      @id @default(uuid())
  name        PackageType @unique
  title       String
  description String?
  isActive    Boolean     @default(true)

  plans        PackagePlan[]
  features     PackageFeature[]
  userPackages UserPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PackageType {
  PREMIUM
  VIP
  VIP_ELITE
}

model PackagePlan {
  id              String   @id @default(uuid())
  packageId       String
  durationMonths  Int // 1, 3, 6
  originalPrice   Decimal  @db.Decimal(10, 2)
  discountedPrice Decimal? @db.Decimal(10, 2)
  discountPercent Float?

  isPopular   Boolean @default(false)
  isBestValue Boolean @default(false)
  isActive    Boolean @default(true)

  package      Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userPackages UserPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([packageId, durationMonths])
  @@index([packageId])
}

model PackageFeature {
  id            String  @id @default(uuid())
  packageId     String
  key           String
  label         String // e.g. "Unlimited Swipes"
  isHighlighted Boolean @default(false)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model UserPackage {
  id        String @id @default(uuid())
  user_id   String @db.Uuid
  packageId String
  planId    String

  startDate DateTime
  endDate   DateTime
  status    PackageStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  package Package     @relation(fields: [packageId], references: [id])
  plan    PackagePlan @relation(fields: [planId], references: [id])

  @@index([user_id])
}

model Payment {
  id         String   @id @default(uuid())
  userId     String   @db.Uuid
  packageId  String?
  amount     Float
  currency   String
  provider   String
  payment_id String   @db.Uuid
  status     String
  created_at DateTime @default(now())
}

model Notification {
  id          String           @id @default(uuid())
  sender_id   String
  receiver_id String
  type        NotificationType
  message     String
  is_read     Boolean          @default(false)
  created_at  DateTime         @default(now())

  @@index([receiver_id])
}

enum OptionType {
  ACTIVITY
  QUICK_TITLE
  VIBE
  WHEN
  TIME
  DURATION
  WHO_PAYS
  JOIN_REQUEST_GENDER
  PLAN_VISIBILITY
}

enum PlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

model DatePlanOption {
  id        String     @id @default(uuid()) @db.Uuid
  type      OptionType
  label     String  // Coffee
  value     String? // coffee
  icon      String? // image url
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Back Relations

  activityPlans DatePlan[] @relation("PlanActivity")

  whenPlans DatePlan[] @relation("PlanWhen")

  timePlans DatePlan[] @relation("PlanTime")

  durationPlans DatePlan[] @relation("PlanDuration")

  whoPaysPlans DatePlan[] @relation("PlanWhoPays")

  joinRequestGenderPlans DatePlan[] @relation("PlanJoinRequestGender")

  visibilityPlans DatePlan[] @relation("PlanVisibility")

  vibePlans DatePlanVibe[]

  @@index([type, isActive])
}

model DatePlan {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @db.Uuid
  // Step 1
  activityId String             @db.Uuid
  title      String?             
  note       String?
  photoUrl   String?

  // Step 2
  venueName    String?
  venueAddress String?
  venueLat     Float?
  venueLng     Float?

  // Step 3
  whenId              String?          @db.Uuid
  timeId              String?          @db.Uuid
  durationId          String?          @db.Uuid
  whoPaysId           String?          @db.Uuid
  participantLimit    Int?
  joinRequestGenderId String?          @db.Uuid
  visibilityId        String?          @db.Uuid
  status              PlanStatus @default(DRAFT)
  eventDateTime       DateTime?
  expiresAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relations

  user User @relation(fields: [userId], references: [id])

  activity DatePlanOption @relation("PlanActivity", fields: [activityId], references: [id])

  when DatePlanOption? @relation("PlanWhen", fields: [whenId], references: [id])

  time DatePlanOption? @relation("PlanTime", fields: [timeId], references: [id])

  duration DatePlanOption? @relation("PlanDuration", fields: [durationId], references: [id])

  whoPays DatePlanOption? @relation("PlanWhoPays", fields: [whoPaysId], references: [id])

  joinRequestGender DatePlanOption? @relation("PlanJoinRequestGender", fields: [joinRequestGenderId], references: [id])

  visibility DatePlanOption? @relation("PlanVisibility", fields: [visibilityId], references: [id])

  vibes    DatePlanVibe[]
  requests DatePlanRequest[]

  @@index([userId])
  @@index([activityId])
  @@index([status])
  @@index([createdAt])
}

model DatePlanVibe {
  id     String @id @default(uuid())
  planId String     @db.Uuid
  vibeId String     @db.Uuid

  plan DatePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  vibe DatePlanOption @relation(fields: [vibeId], references: [id])

  @@unique([planId, vibeId])
  @@index([vibeId])
}

enum DatePlanRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

model DatePlanRequest {
  id     String @id @default(uuid())
  // Which plan
  planId String                     @db.Uuid

  // Who sent request
  requesterId String                @db.Uuid
  status      DatePlanRequestStatus @default(PENDING)
  message     String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  plan DatePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  requester User @relation(fields: [requesterId], references: [id])

  @@unique([planId, requesterId])
  @@index([planId])
  @@index([requesterId])
  @@index([status])
}

enum NotificationType {
  LIKE
  MATCH
  MESSAGE
}

enum Gender {
  MEN
  WOMEN
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum GenderOption {
  STRAIGHT
  GAY
  LESBIAN
  AROMATIC
  ASEXUAL
  BISEXUAL
  DEMISEXUAL
  PANSEXUAL
  QUEER
  NOT_LISTED
}

enum BoostType {
  BOOST
  PRIMETIME
  SUPER
}

enum BoostStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum PackageStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LookingFor {
  DATE_TO_MARRY
  DATING
  MATURE_CONNECTION
}

enum LookingForOption {
  LONG_TERM
  SHORT_TERM
  NEW_FRIENDS
  CASUAL
  COMPANIONSHIP
  LIFE_PARTNER
  TRAVEL_PARTNER
  EMOTIONAL_SUPPORT
  FRIENDSHIP_FIRST
}

enum MaritalStatus {
  NEVER_MARRIED
  DIVORCED
  WIDOWED
  AWAITING_DIVORCE
  ANNULLED
}

enum ChildStatus {
  YES
  NO
  PREFER_NOT_TO_SAY
}

enum NumberOfChildren {
  ONE
  TWO
  THREE
  FOUR
  FIVE_PLUS
}

enum ChildLivingArrangement {
  YES
  NO
  SOMETIME
}

enum LivingSituation {
  OWN_HOME
  LIVING_ALONE
  WITH_CHILDREN
  WITH_FAMILY
  RENTED_HOME
  SENIOR_LIVING_COMMUNITY
  OTHER
}

enum IncomeRangeType {
  UPTO_1_LAKH
  INR_1_TO_2_LAKH
  INR_2_TO_4_LAKH
  INR_4_TO_7_LAKH
  INR_10_TO_15_LAKH
  INR_15_TO_20_LAKH
  INR_20_TO_30_LAKH
  INR_30_TO_50_LAKH
  INR_50_TO_75_LAKH
  ABOVE_75_LAKH
}

enum WorkingWith {
  PRIVATE_COMPANY
  GOVERNMENT
  CIVIL_SERVICES
  SELF_EMPLOYED
  NOT_WORKING
}

enum QuestionCategory {
  DATING
  DATE_TO_MARRY
  MATURE_CONNECTION
}

enum QuestionScreen {
  LIFESTYLE
  REAL_U_MATTERS
  THINGS_U_LOVE
  INTEREST_HOBBY
  DREAM_PLAN
  HEALTH_WELLNESS
}

enum SwipeAction {
  LIKE
  PASS
  SUPERLIKE
}
