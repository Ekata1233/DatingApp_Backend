generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                @id @default(uuid()) @db.Uuid
  full_name                  String?               @db.VarChar(100)
  email                      String?               @unique @db.VarChar(255)
  phone_number               String?               @unique @db.VarChar(20)
  is_phone_verified          Boolean               @default(false)
  google_id                  String?               @unique @db.VarChar(255)
  birth_date                 DateTime?             @db.Date
  height                     Int?
  gender                     Gender?
  gender_option              GenderOption?
  looking_for                LookingFor?
  intentionId                String?               @db.Uuid
  onboarding_step            String?               @db.VarChar(20)
  next_step                  String?               @db.VarChar(20)
  onboarding_completed       Boolean               @default(false)
  last_active_at             DateTime?
  device_token               String?
  referralCode               String?               @unique @db.VarChar(20)
  badge_count                Int                   @default(0)
  deleted_at                 DateTime?
  created_at                 DateTime              @default(now())
  updated_at                 DateTime              @updatedAt
  profile_completion         Int                   @default(0)
  looking_for_option         LookingForOption?
  answer                     UserAnswer[]
  matchesAsUser1             UserMatch[]           @relation("MatchUser1")
  matchesAsUser2             UserMatch[]           @relation("MatchUser2")
  swipesGiven                UserSwipe[]           @relation("Swiper")
  swipesReceived             UserSwipe[]           @relation("TargetUser")
  about                      UserAbout?
  bio                        UserBio?
  eduWork                    UserEduWork?          @relation("UserEduWork")
  familyProfile              UserFamilyProfile?    @relation("UserFamilyProfile")
  skills                     UserSkill[]
  photos                     UserPhoto[]
  profile                    UserProfile?
  userBoosts                 UserBoost[]
  boostUsages                BoostUsage[]
  userPackages               UserPackage[]
  boostEvents                BoostEvent[]          @relation("BoostedUser")
  actorEvents                BoostEvent[]          @relation("ActorUser")
  boostStats                 UserBoostStats?
  boostPurchases             BoostPurchase[]
  boostTransactions          BoostTransaction[]
  datePlan                   DatePlan[]
  datePlanRequests           DatePlanRequest[]
  datePlanSkips              DatePlanSkip[]
  hostedConfirmedDates       DateConfirmed[]       @relation("ConfirmedDateHost")
  joinedConfirmedDates       DateConfirmed[]       @relation("ConfirmedDateParticipant")
  wallet                     Wallet?
  datePlanStats              DatePlanUserStats?
  datePlanPurchases          DatePlanPurchase[]
  datePlanTransactions       DatePlanTransaction[]
  datePlanFeedbackAsReviewer DatePlanFeedback[]    @relation("DatePlanFeedbackReviewer")
  datePlanFeedbackAsMetUser  DatePlanFeedback[]    @relation("DatePlanFeedbackMetUser")
  datePlanReportsMade        DatePlanReport[]      @relation("DatePlanReportReporter")
  datePlanReportsReceived    DatePlanReport[]      @relation("DatePlanReportedUser")

  intention        IntentionOption?   @relation(fields: [intentionId], references: [id])
  userPrompts      UserPrompt[]
  UserPlanUsage    UserPlanUsage[]
  waitlist         Waitlist?
  referralsMade    UserReferral[]     @relation("Referrer")
  referralStats    UserReferralStats?
  receivedReferral UserReferral?      @relation("ReferredUser")

  //chat
  conversationParticipants ConversationParticipant[]
  sentChatMessages         ChatMessage[]             @relation("ChatMessageSender")

  // Roses
  rosesSent        UserRose[]        @relation("RoseSender")
  rosesReceived    UserRose[]        @relation("RoseReceiver")
  roseBalance      UserRoseBalance?
  rosePurchases    RosePurchase[]
  roseTransactions RoseTransaction[]

  // Compliments
  complimentsSent        UserCompliment[]        @relation("ComplimentSender")
  complimentsReceived    UserCompliment[]        @relation("ComplimentReceiver")
  complimentBalance      UserComplimentBalance?
  complimentPurchases    ComplimentPurchase[]
  complimentTransactions ComplimentTransaction[]

  // Gifts
  giftsSent           UserGift[]            @relation("GiftSender")
  giftsReceived       UserGift[]            @relation("GiftReceiver")
  ChatMessageDeletion ChatMessageDeletion[]

  @@index([phone_number])
  @@index([google_id])
  @@index([gender, created_at])
  @@index([created_at])
  @@map("users")
}

model UserProfile {
  user_id            String         @id @db.Uuid
  religionId         Int?
  religion           Religion?      @relation(fields: [religionId], references: [id])
  communityId        Int?
  community          Community?     @relation(fields: [communityId], references: [id])
  languages          UserLanguage[]
  interested_in      Gender?
  sexual_orientation GenderOption?
  country            String?        @db.VarChar(30)
  state              String?        @db.VarChar(30)
  city               String?        @db.VarChar(30)
  area               String?        @db.VarChar(30)
  max_distance_km    Int?
  latitude           Decimal?       @db.Decimal(10, 8)
  longitude          Decimal?       @db.Decimal(11, 8)
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  user               User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([religionId])
  @@index([communityId])
  @@index([interested_in])
  @@index([sexual_orientation])
  @@index([country, state, city])
  @@index([latitude, longitude])
  @@map("user_profiles")
}

model UserReferral {
  id             String         @id @default(uuid()) @db.Uuid
  referrerId     String         @db.Uuid
  referredUserId String         @unique @db.Uuid
  status         ReferralStatus @default(PENDING)
  signupReward   Decimal        @default(0) @db.Decimal(10, 2)
  purchaseReward Decimal        @default(0) @db.Decimal(10, 2)
  rewardedAt     DateTime?
  purchaseAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrer     User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser User @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([referrerId])
  @@index([referredUserId])
  @@index([createdAt])
}

model UserReferralStats {
  userId           String   @id @db.Uuid
  totalInvites     Int      @default(0)
  joinedUsers      Int      @default(0)
  pendingRewards   Int      @default(0)
  rewardedUsers    Int      @default(0)
  totalCoinsEarned Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ReferralStatus {
  PENDING
  SIGNUP_REWARDED
  PACKAGE_REWARDED
  WAITLIST_REWARDED
  CANCELLED
}

model UserLanguage {
  userId     String      @db.Uuid
  languageId Int
  user       UserProfile @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  language   Language    @relation(fields: [languageId], references: [id])
  createdAt  DateTime    @default(now())

  @@id([userId, languageId])
  @@index([languageId])
  @@index([userId])
  @@map("user_languages")
}

model Religion {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(100)
  priority    Int           @default(0)
  active      Boolean       @default(true)
  communities Community[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  UserProfile UserProfile[]

  @@index([active])
  @@map("religions")
}

model Community {
  id           Int           @id @default(autoincrement())
  religionId   Int
  religion     Religion      @relation(fields: [religionId], references: [id], onDelete: Cascade)
  name         String        @db.VarChar(100)
  priority     Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userProfiles UserProfile[]

  @@unique([religionId, name])
  @@index([religionId])
  @@index([active])
  @@map("communities")
}

model Language {
  id        Int            @id @default(autoincrement())
  name      String         @unique @db.VarChar(50)
  priority  Int            @default(0)
  active    Boolean        @default(true)
  users     UserLanguage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([active])
  @@map("languages")
}

model UserAbout {
  user_id                String                  @id @db.Uuid
  maritalStatus          MaritalStatus?
  childStatus            ChildStatus?
  numberOfChildren       NumberOfChildren?
  childLivingArrangement ChildLivingArrangement?
  livingSituation        LivingSituation?
  zodiac                 Zodiac?
  loveLanguage           LoveLanguage?
  communicationStyle     CommunicationStyle?
  created_at             DateTime                @default(now())
  updated_at             DateTime                @updatedAt
  user                   User                    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([maritalStatus])
  @@index([childStatus])
  @@map("user_about")
}

enum Zodiac {
  ARIES
  TAURUS
  GEMINI
  CANCER
  LEO
  VIRGO
  LIBRA
  SCORPIO
  SAGITTARIUS
  CAPRICORN
  AQUARIUS
  PISCES
}

enum LoveLanguage {
  WORDS_OF_AFFIRMATION
  QUALITY_TIME
  ACTS_OF_SERVICE
  PHYSICAL_TOUCH
  RECEIVING_GIFTS
}

enum CommunicationStyle {
  PHONE_CALLS_OVER_TEXTS
  TEXTS_OVER_CALLS
  VIDEO_CALLS
  VOICE_NOTES
  IN_PERSON_ALWAYS
  A_BIT_OF_EVERYTHING
}

model UserEduWork {
  userId String @id @db.Uuid

  // Education
  highestEdu     EducationLevel?
  degree         String?         @db.VarChar(100)
  collegeName    String?         @db.VarChar(100)
  graduationYear Int?

  // Work
  professionId     Int?
  profession       Profession?     @relation(fields: [professionId], references: [id], onDelete: SetNull)
  companyName      String?         @db.VarChar(100)
  employmentTypeId Int?
  employmentType   EmploymentType? @relation(fields: [employmentTypeId], references: [id], onDelete: SetNull)
  experienceId     Int?
  experience       Experience?     @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  ambitionId       Int?
  ambition         Ambition?       @relation(fields: [ambitionId], references: [id], onDelete: SetNull)
  salaryRangeId    Int?
  salaryRange      SalaryRange?    @relation(fields: [salaryRangeId], references: [id], onDelete: SetNull)
  bigDreams        String?         @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserEduWork", fields: [userId], references: [id], onDelete: Cascade)

  @@index([highestEdu])
  @@index([degree])
  @@index([graduationYear])
  @@index([professionId])
  @@index([employmentTypeId])
  @@index([experienceId])
  @@index([ambitionId])
  @@index([salaryRangeId])
  @@map("user_edu_work")
}

model UserFamilyProfile {
  id                   String        @id @default(uuid()) @db.Uuid
  userId               String        @unique @db.Uuid
  user                 User          @relation("UserFamilyProfile", fields: [userId], references: [id], onDelete: Cascade)
  familyStatusId       Int?
  familyStatus         MasterValue?  @relation("FamilyStatus", fields: [familyStatusId], references: [id])
  familyTypeId         Int?
  familyType           MasterValue?  @relation("FamilyType", fields: [familyTypeId], references: [id])
  fatherOccupationId   Int?
  fatherOccupation     MasterValue?  @relation("FatherOccupation", fields: [fatherOccupationId], references: [id])
  fatherOrganisationId Int?
  fatherOrganisation   MasterValue?  @relation("FatherOrganisation", fields: [fatherOrganisationId], references: [id])
  motherOccupationId   Int?
  motherOccupation     MasterValue?  @relation("MotherOccupation", fields: [motherOccupationId], references: [id])
  motherOrganisationId Int?
  motherOrganisation   MasterValue?  @relation("MotherOrganisation", fields: [motherOrganisationId], references: [id])
  familyHomeId         Int?
  familyHome           MasterValue?  @relation("FamilyHome", fields: [familyHomeId], references: [id])
  nativePlaceId        Int?
  nativePlace          MasterValue?  @relation("NativePlace", fields: [nativePlaceId], references: [id])
  familyIncomeId       Int?
  familyIncome         FamilyIncome? @relation(fields: [familyIncomeId], references: [id])
  siblings             UserSibling[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([familyStatusId])
  @@index([familyTypeId])
  @@index([fatherOccupationId])
  @@index([motherOccupationId])
  @@index([familyHomeId])
  @@index([nativePlaceId])
  @@index([familyIncomeId])
  @@map("user_family_profiles")
}

model UserSibling {
  id              String            @id @default(uuid()) @db.Uuid
  familyProfileId String            @db.Uuid
  familyProfile   UserFamilyProfile @relation(fields: [familyProfileId], references: [id], onDelete: Cascade)
  siblingTypeId   Int
  siblingType     MasterValue       @relation("SiblingType", fields: [siblingTypeId], references: [id])

  maritalId Int?
  marital   MasterValue? @relation("SiblingMarital", fields: [maritalId], references: [id])

  occupationId Int?
  occupation   MasterValue? @relation("SiblingOccupation", fields: [occupationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_siblings")
}

model MasterCategory {
  id        Int           @id @default(autoincrement())
  code      String        @unique
  title     String
  values    MasterValue[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("master_categories")
}

model MasterValue {
  id         Int            @id @default(autoincrement())
  categoryId Int
  category   MasterCategory @relation(fields: [categoryId], references: [id])
  value      String
  priority   Int            @default(0)
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())

  // UserFamilyProfile Relations
  familyStatuses      UserFamilyProfile[] @relation("FamilyStatus")
  familyTypes         UserFamilyProfile[] @relation("FamilyType")
  fatherOccupations   UserFamilyProfile[] @relation("FatherOccupation")
  fatherOrganisations UserFamilyProfile[] @relation("FatherOrganisation")
  motherOccupations   UserFamilyProfile[] @relation("MotherOccupation")
  motherOrganisations UserFamilyProfile[] @relation("MotherOrganisation")
  siblingTypes        UserSibling[]       @relation("SiblingType")
  siblingOccupations  UserSibling[]       @relation("SiblingOccupation")
  siblingMaritals     UserSibling[]       @relation("SiblingMarital")
  familyHomes         UserFamilyProfile[] @relation("FamilyHome")
  nativePlaces        UserFamilyProfile[] @relation("NativePlace")

  @@index([categoryId])
  @@map("master_values")
}

model FamilyIncome {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(100)
  minAmount Int?
  maxAmount Int?
  priority  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userProfiles UserFamilyProfile[]

  @@map("family_income")
}

model Profession {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  isActive     Boolean       @default(true)
  userEduWorks UserEduWork[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("professions")
}

model EmploymentType {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  isActive     Boolean       @default(true)
  userEduWorks UserEduWork[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("employment_types")
}

model Experience {
  id           Int           @id @default(autoincrement())
  title        String        @unique // Fresher, 1 yr exp, 3 yrs exp
  sortOrder    Int?
  isActive     Boolean       @default(true)
  userEduWorks UserEduWork[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("experiences")
}

model Ambition {
  id           Int           @id @default(autoincrement())
  title        String        @unique
  isActive     Boolean       @default(true)
  userEduWorks UserEduWork[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("ambitions")
}

model SalaryRange {
  id           Int           @id @default(autoincrement())
  title        String        @unique // ₹10–20 LPA
  minSalary    Int?
  maxSalary    Int?
  isActive     Boolean       @default(true)
  userEduWorks UserEduWork[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("salary_ranges")
}

enum EducationLevel {
  HIGH_SCHOOL
  ITI
  DIPLOMA
  UNDERGRADUATE
  BACHELOR
  POSTGRADUATE
  MASTER
  MPHIL
  PHD
  POST_DOCTORATE
}

model Skill {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)
  slug String @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserSkill[]

  @@index([name])
  @@map("skills")
}

model UserSkill {
  id String @id @default(uuid()) @db.Uuid

  userId  String @db.Uuid
  skillId String @db.Uuid

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

model Question {
  id         String           @id @default(uuid()) @db.Uuid
  key        String           @unique
  title      String
  category   QuestionCategory
  isMulti    Boolean          @default(false)
  created_at DateTime         @default(now())
  updated_at DateTime         @updatedAt
  screen     QuestionScreen
  options    QuestionOption[]
  answers    UserAnswer[]
}

model QuestionOption {
  id          String       @id @default(uuid())
  question_id String       @db.Uuid
  value       String
  label       String
  created_at  DateTime     @default(now())
  question    Question     @relation(fields: [question_id], references: [id], onDelete: Cascade)
  answers     UserAnswer[]

  @@index([question_id])
}

model UserAnswer {
  id          String         @id @default(uuid()) @db.Uuid
  user_id     String         @db.Uuid
  question_id String         @db.Uuid
  option_id   String
  description String?        @db.Text
  created_at  DateTime       @default(now())
  option      QuestionOption @relation(fields: [option_id], references: [id], onDelete: Cascade)
  question    Question       @relation(fields: [question_id], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id, option_id])
  @@index([user_id])
  @@index([question_id])
  @@index([option_id])
}

model UserPhoto {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  is_primary Boolean   @default(false)
  order      Int?
  created_at DateTime  @default(now())
  media_type MediaType @default(IMAGE)
  media_url  String
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_photos")
}

enum MediaType {
  IMAGE
  VIDEO
}

model UserBio {
  user_id    String   @id @db.Uuid
  bio        String?  @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_bio")
}

model UserPrompt {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  promptId     String   @db.Uuid
  answer       String   @db.VarChar(300)
  displayOrder Int      @default(1)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt       Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, promptId])
  @@index([userId])
  @@index([promptId])
  @@map("user_prompts")
}

enum PromptVisibility {
  EVERYONE
  PREMIUM_AND_ABOVE
  VIP_AND_ABOVE
  ELITE_ONLY
}

model PromptCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  priority    Int      @default(0)
  active      Boolean  @default(true)
  prompts     Prompt[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prompt_categories")
}

model Prompt {
  id          String           @id @default(uuid()) @db.Uuid
  categoryId  String           @db.Uuid
  question    String           @db.VarChar(255)
  active      Boolean          @default(true)
  priority    Int              @default(0)
  maxLength   Int              @default(200)
  visibility  PromptVisibility @default(EVERYONE)
  category    PromptCategory   @relation(fields: [categoryId], references: [id])
  userPrompts UserPrompt[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([active])
  @@map("prompts")
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model UserReport {
  id         String   @id @default(uuid()) @db.Uuid
  reporterId String
  reportedId String
  createdAt  DateTime @default(now())

  @@unique([reporterId, reportedId])
}

model UserSwipe {
  id           String      @id @default(uuid()) @db.Uuid
  swiperId     String      @db.Uuid
  targetUserId String      @db.Uuid
  action       SwipeAction
  isMutual     Boolean     @default(false)
  created_at   DateTime    @default(now())
  swiper       User        @relation("Swiper", fields: [swiperId], references: [id], onDelete: Cascade)
  targetUser   User        @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([swiperId, targetUserId])
  @@index([swiperId])
  @@index([targetUserId])
  @@index([action])
  @@index([created_at])
  @@index([swiperId, action])
  @@index([targetUserId, action])
  @@map("swipes")
}

model UserMatch {
  id              String    @id @default(uuid()) @db.Uuid
  user1Id         String    @db.Uuid
  user2Id         String    @db.Uuid
  matched_at      DateTime  @default(now())
  last_message_at DateTime?
  is_active       Boolean   @default(true)
  is_deleted      Boolean   @default(false)
  user1           User      @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User      @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([matched_at])
  @@index([last_message_at])
  @@index([is_active])
  @@index([user1Id, is_active])
  @@index([user2Id, is_active])
  @@map("matches")
}

model Intention {
  id          String            @id @default(uuid()) @db.Uuid
  title       String
  description String?
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  options     IntentionOption[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model IntentionOption {
  id             String    @id @default(uuid()) @db.Uuid
  option         String
  optDescription String?
  intentionId    String    @db.Uuid
  intention      Intention @relation(fields: [intentionId], references: [id], onDelete: Cascade)
  users          User[]
  createdAt      DateTime  @default(now())
}

model Boost {
  id                     String    @id @default(uuid()) @db.Uuid
  name                   BoostType @unique
  title                  String
  description            String?
  is_active              Boolean   @default(true)
  // New fields - different for each BoostType
  boostDuration          Int       @default(30)
  singleBoostWalletPrice Decimal   @default(60) @db.Decimal(10, 2)
  visibilityMultiplier   Int       @default(10)

  // Existing fields
  whyBoostWorks     Json?
  boostVsSuperBoost Json?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  options           BoostOption[]
  userBoosts        UserBoost[]

  @@map("boosts")
}

model BoostOption {
  id               String          @id @default(uuid()) @db.Uuid
  boost_id         String          @db.Uuid
  label            String
  boostCount       Int
  timePerBoost     Int
  pricePerBoost    Decimal         @db.Decimal(10, 2)
  discounted_price Decimal         @db.Decimal(10, 2)
  discount_percent Int?
  totalPrice       Decimal         @db.Decimal(10, 2)
  is_best_value    Boolean         @default(false)
