
{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/@ffprobe-installer/linux-x64/**",
          "node_modules/@ffmpeg-installer/linux-x64/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api-docs",
      "dest": "src/server.ts"
    },
    {
      "src": "/api-docs/(.*)",
      "dest": "src/server.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/server.ts"
    }
  ]
}
